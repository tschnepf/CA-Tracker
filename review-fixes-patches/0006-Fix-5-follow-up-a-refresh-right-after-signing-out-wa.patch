From 4df343210ff5fa03c670966896d99d0732c09089 Mon Sep 17 00:00:00 2001
From: "Claude Fable 5.1" <noreply@anthropic.com>
Date: Thu, 1 Oct 2026 17:03:57 -0700
Subject: [PATCH] Fix #5 follow-up: a refresh right after signing out waits
 instead of failing

Signing out paused the hidden Helix and Procore pages for 30 s; a
refresh started inside that window (sign out, sign back in, Refresh)
returned "did not finish" for every project without touching Helix.
Now the pause is lifted as soon as the profile folder is deleted, and a
sync that still meets a pause waits it out (logged) rather than failing.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012FcZmvTPSZepfx3fMqvoPu
---
 .../src/SmcCaTracker.App/Services/HelixSyncService.cs      | 7 +++++--
 .../src/SmcCaTracker.App/Services/ProcoreSyncService.cs    | 7 +++++--
 .../src/SmcCaTracker.App/ViewModels/MainViewModel.cs       | 3 +++
 3 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/windows-helper/src/SmcCaTracker.App/Services/HelixSyncService.cs b/windows-helper/src/SmcCaTracker.App/Services/HelixSyncService.cs
index bf7cea8..ed5db8c 100644
--- a/windows-helper/src/SmcCaTracker.App/Services/HelixSyncService.cs
+++ b/windows-helper/src/SmcCaTracker.App/Services/HelixSyncService.cs
@@ -100,9 +100,12 @@ public sealed class HelixSyncService : IDisposable
             return new ProviderSyncResult();
         }
 
-        if (DateTimeOffset.Now < pausedUntil)
+        // Signing out deletes the browser's files: wait until that is over rather than failing the read.
+        var pause = pausedUntil - DateTimeOffset.Now;
+        if (pause > TimeSpan.Zero)
         {
-            return Problem("Helix reads are paused for a moment while the browser signs out.");
+            AppLog.Info("helix", $"Waiting {pause.TotalSeconds:0} s for the browser to finish signing out.");
+            await Task.Delay(pause);
         }
 
         await gate.WaitAsync();
diff --git a/windows-helper/src/SmcCaTracker.App/Services/ProcoreSyncService.cs b/windows-helper/src/SmcCaTracker.App/Services/ProcoreSyncService.cs
index 9e25086..a48bd89 100644
--- a/windows-helper/src/SmcCaTracker.App/Services/ProcoreSyncService.cs
+++ b/windows-helper/src/SmcCaTracker.App/Services/ProcoreSyncService.cs
@@ -555,9 +555,12 @@ public sealed class ProcoreSyncService : IDisposable
     {
         if (core is null)
         {
-            if (DateTimeOffset.Now < pausedUntil)
+            // Signing out deletes the browser's files: wait until that is over rather than failing the read.
+            var pause = pausedUntil - DateTimeOffset.Now;
+            if (pause > TimeSpan.Zero)
             {
-                return new PageProblem("Procore reads are paused for a moment while the browser signs out.", false);
+                AppLog.Info("procore", $"Waiting {pause.TotalSeconds:0} s for the browser to finish signing out.");
+                await Task.Delay(pause);
             }
 
             try
diff --git a/windows-helper/src/SmcCaTracker.App/ViewModels/MainViewModel.cs b/windows-helper/src/SmcCaTracker.App/ViewModels/MainViewModel.cs
index f4af168..b03f11c 100644
--- a/windows-helper/src/SmcCaTracker.App/ViewModels/MainViewModel.cs
+++ b/windows-helper/src/SmcCaTracker.App/ViewModels/MainViewModel.cs
@@ -270,6 +270,9 @@ public sealed class MainViewModel : ObservableObject, IDisposable
             }
         }
 
+        // The files are gone: the hidden pages may open again (they start signed out and ask to sign in).
+        helixSync.CloseBrowser(pause: TimeSpan.Zero);
+        procoreSync.CloseBrowser(pause: TimeSpan.Zero);
         AppLog.Info("app", "Signed out of the built-in browser.");
         RefreshAccounts();
         return null;
-- 
