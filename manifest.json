{
  "manifest_version": 3,
  "name": "My Helix Activity",
  "version": "1.9.8",
  "key": "",
  "description": "Review Helix RFI and Submittal activity, with optional sync to a self-hosted Task Hub.",
  "permissions": [
    "scripting",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://project.helixteam.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://project.helixteam.com/Projects/*/Overview*",
        "https://project.helixteam.com/Projects/*/RFI*",
        "https://project.helixteam.com/Projects/*/Submittals*"
      ],
      "js": [
        "activity-core.js",
        "integrations/taskhub/mapper.js",
        "ui.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "My Helix Activity"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
