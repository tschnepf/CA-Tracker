{
  "manifest_version": 3,
  "name": "TaskHub Helper for Helix & Procore",
  "version": "2.3.0",
  "key": "",
  "description": "Review and sync RFI and Submittal assignments in Helix or Procore from one site-aware extension.",
  "permissions": [
    "scripting",
    "storage",
    "identity"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://project.helixteam.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://project.helixteam.com/Projects/*/Overview*",
        "https://project.helixteam.com/Projects/*/RFI*",
        "https://project.helixteam.com/Projects/*/Submittals*",
        "https://*.procore.com/webclients/host/*",
        "https://*.procore.com/*/project/*"
      ],
      "js": [
        "refresh-capture.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://project.helixteam.com/Projects/*/Overview*",
        "https://project.helixteam.com/Projects/*/RFI*",
        "https://project.helixteam.com/Projects/*/Submittals*"
      ],
      "js": [
        "activity-core.js",
        "integrations/taskhub/mapper.js",
        "integrations/windows-helper/snapshot.js",
        "ui.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.procore.com/webclients/host/*",
        "https://*.procore.com/*/project/*"
      ],
      "js": [
        "provider-core.js",
        "activity-core.js",
        "integrations/taskhub/mapper.js",
        "integrations/windows-helper/snapshot.js",
        "procore-core.js",
        "ui.js",
        "procore-content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TaskHub Helper"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
