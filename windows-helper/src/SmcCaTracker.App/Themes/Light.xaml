<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Keys are shared with Light/Dark; styles use DynamicResource. -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F4F7FA" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBackground" Color="#F7F9FB" />
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#D5DEE6" />
    <SolidColorBrush x:Key="TextPrimary" Color="#13202B" />
    <SolidColorBrush x:Key="TextSecondary" Color="#4B5E6D" />
    <SolidColorBrush x:Key="TextMuted" Color="#5A6B78" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0B6FB3" />
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCEEFB" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EEF3F7" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#D6E9F8" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B3261E" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBE3E1" />
    <SolidColorBrush x:Key="WarningBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF1D6" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E7A45" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DDF3E6" />
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#EBEFF3" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3CDD6" />
</ResourceDictionary>
