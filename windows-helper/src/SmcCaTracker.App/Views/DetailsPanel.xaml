<UserControl x:Class="SmcCaTracker.App.Views.DetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <!-- A label beside its value. -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Width" Value="82" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <!-- The selected item, from what CA Tracker has synced (nothing is read from Helix to show it), and the
         files in its folder. The row is the DataContext. -->
    <Border Style="{StaticResource Card}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="14,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="✕" Click="Close_Click"
                            AutomationProperties.Name="Hide item details" ToolTip="Hide item details (View → Item details shows them again)" />
                    <TextBlock Text="ITEM DETAILS" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <TextBlock x:Name="EmptyText" Margin="14" Style="{StaticResource Muted}" Text="Select an item in the list to see it here." />
                    <StackPanel x:Name="Body" Margin="14,12" Visibility="Collapsed">
                        <TextBlock Text="{Binding DetailsCrumb}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TitleText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />

                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource AccentButton}" Content="{Binding OpenOnlineText}" Click="Open_Click" IsEnabled="{Binding HasItem}"
                                    Margin="0,0,6,6" ToolTip="Helix items open here, in this panel; Procore items open in your web browser" />
                            <Button Content="Download…" Click="Download_Click" IsEnabled="{Binding CanDownload}" Margin="0,0,6,6"
                                    ToolTip="{Binding DownloadToolTip}" ToolTipService.ShowOnDisabled="True" />
                            <Button Content="Open folder" Click="Folder_Click" IsEnabled="{Binding HasFolder}" Margin="0,0,6,6" />
                        </WrapPanel>

                        <StackPanel Margin="0,6,0,0">
                            <DockPanel Margin="0,3">
                                <TextBlock Text="Due" Style="{StaticResource Label}" />
                                <TextBlock ToolTip="{Binding DueToolTip}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Value}">
                                            <Setter Property="Text" Value="{Binding DueText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DueText}" Value="">
                                                    <Setter Property="Text" Value="No due date" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDueToday}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="With" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding WithText}" Style="{StaticResource Value}" ToolTip="{Binding CourtToolTip}" />
                            </DockPanel>
                            <DockPanel Margin="0,3" Visibility="{Binding HasNext, Converter={StaticResource Visible}}">
                                <TextBlock Text="Next" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding NextText}" Style="{StaticResource Value}" />
                            </DockPanel>
                            <!-- Workload Tracker: who is assigned, and who marked it complete there (warning colour while it
                                 still needs returning in Helix or Procore). -->
                            <DockPanel Margin="0,3" Visibility="{Binding ShowsAssignedDetails, Converter={StaticResource Visible}}">
                                <TextBlock Text="Assigned" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding AssignedDetailsText}" Style="{StaticResource Value}" ToolTip="{Binding AssignedToolTip}" />
                            </DockPanel>
                            <DockPanel Margin="0,3" Visibility="{Binding HasCompletions, Converter={StaticResource Visible}}">
                                <TextBlock Text="Workload Tracker" Style="{StaticResource Label}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CompletedText}" ToolTip="{Binding DoneFlagToolTip}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Value}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowsDoneFlag}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <DockPanel Margin="0,3" Visibility="{Binding HasItem, Converter={StaticResource Visible}}">
                                <TextBlock Text="Status" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding ProviderStatus}" Style="{StaticResource Value}" />
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="Folder" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding FolderPathText}" Style="{StaticResource Value}" />
                            </DockPanel>
                            <DockPanel Margin="0,3" Visibility="{Binding HasFolderNote, Converter={StaticResource Visible}}">
                                <TextBlock Text="Folder status" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding ToolTipText}" Style="{StaticResource Value}" Foreground="{DynamicResource WarningBrush}" />
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="Discipline" Style="{StaticResource Label}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Set" Click="Discipline_Click"
                                        IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Padding="6,0"
                                        ToolTip="Choose the discipline. For an item with no folder yet, its download goes into that discipline's folder." />
                                <TextBlock Text="{Binding DisciplineText}" Style="{StaticResource Value}" ToolTip="{Binding DisciplineToolTip}" />
                            </DockPanel>
                        </StackPanel>

                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource LinkButton}" Content="Open newest file" Click="Newest_Click" IsEnabled="{Binding CanDownload}"
                                    Margin="-6,0,6,0" ToolTip="The copy in its folder when it's there, otherwise a copy from Helix (the CA folder isn't changed)" />
                            <Button Style="{StaticResource LinkButton}" Content="Verify folder…" Click="Verify_Click" IsEnabled="{Binding CanDownload}"
                                    ToolTip="Check that its folder has every file Helix has for it" />
                        </WrapPanel>

                        <TextBlock Text="IN ITS FOLDER" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                        <TextBlock x:Name="FilesStatus" Style="{StaticResource Muted}" FontSize="12" />
                        <ItemsControl x:Name="FilesList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Open" Click="OpenFile_Click"
                                                VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock Text="{Binding When}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
