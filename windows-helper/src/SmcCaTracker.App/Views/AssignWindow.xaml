<Window x:Class="SmcCaTracker.App.Views.AssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign to"
        Width="480" Height="580" MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="SubjectText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Find" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{DynamicResource TextSecondary}" />
            <TextBox x:Name="FilterBox" TextChanged="Filter_Changed" VerticalContentAlignment="Center" AutomationProperties.Name="Find a person" />
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="PeopleList" AutomationProperties.Name="Team">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="{Binding IsMixed}" Margin="4,4,4,6"
                                          VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Name}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" Margin="10" VerticalAlignment="Top" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="MixedNote" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                       Text="A filled box means only some of these items have that person; leave it so to keep them as they are." />
            <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="People on the project's team in Workload Tracker. Workload Tracker lets them know, and CA Tracker lists the items under Assigned to me in their My work." />
            <Button x:Name="ReloadButton" Content="Reload the team" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Reload_Click" />
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="ErrorText" DockPanel.Dock="Left" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="250" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="_Save" Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click" MinWidth="80" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
