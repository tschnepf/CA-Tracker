<UserControl x:Class="SmcCaTracker.App.Views.ProjectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="Page_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <!-- New project / Edit project, shown in place of the project list. Save keeps the page open. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                       Text="Changes apply when you save. Nothing in the CA folder changes." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="PROJECT" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Name" Foreground="{DynamicResource TextSecondary}" />
                            <TextBox x:Name="NameBox" Margin="0,4,0,10" />
                            <TextBlock Text="CA folder" Foreground="{DynamicResource TextSecondary}" />
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseFolder_Click" Margin="8,0,0,0" />
                                <TextBox x:Name="FolderBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12"
                                       Text="Choosing a folder only records it in the tracker. Nothing in the folder changes." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="HELIX / PROCORE PROJECT" Style="{StaticResource SectionTitle}" />
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="_Link…" Click="Connect_Click" Margin="8,0,0,0" />
                                    <Button x:Name="DisconnectButton" Content="Unlink" Click="Disconnect_Click" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="ConnectionText" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12"
                                       Text="Link the project to its Helix or Procore project so Sync can read its RFIs and Submittals." />
                        </StackPanel>
                    </Border>

                    <!-- Shown while connected to Workload Tracker (Settings → Connections). -->
                    <Border x:Name="WorkloadCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="WORKLOAD TRACKER" Style="{StaticResource SectionTitle}" />
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="ChooseBindingButton" Content="C_hoose…" Click="ChooseBinding_Click" Margin="8,0,0,0" />
                                    <Button x:Name="UnbindButton" Content="Unbind" Click="Unbind_Click" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="BindingText" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <DockPanel x:Name="ConflictPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                <Button x:Name="UseTheirsButton" DockPanel.Dock="Right" Content="Use theirs" Click="UseTheirs_Click" Margin="8,0,0,0"
                                        VerticalAlignment="Center" />
                                <TextBlock x:Name="ConflictText" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="BindingNote" Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                       Text="The project in Workload Tracker that this project's RFIs and Submittals belong to. Only existing projects that are running can be chosen; choosing one sends this project's items to it when you save." />

                            <!-- The Workload Tracker project's team, each linked to who they are in Helix or Procore. -->
                            <StackPanel x:Name="TeamPanel" Margin="0,18,0,0" Visibility="Collapsed">
                                <DockPanel>
                                    <Button x:Name="TeamRefreshButton" DockPanel.Dock="Right" Content="Refresh" Click="TeamRefresh_Click" Margin="8,0,0,0" />
                                    <Button x:Name="ConfirmTeamButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="ConfirmTeam_Click"
                                            Visibility="Collapsed" />
                                    <TextBlock Text="TEAM IN WORKLOAD TRACKER" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                                </DockPanel>
                                <TextBlock x:Name="TeamNote" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock x:Name="TeamSummary" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                                <TextBlock x:Name="TeamProblem" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                                <ItemsControl x:Name="TeamList" Margin="0,8,0,0" AutomationProperties.Name="Team in Workload Tracker">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="170" />
                                                        <ColumnDefinition Width="300" />
                                                        <ColumnDefinition Width="170" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                                                   TextTrimming="CharacterEllipsis" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                                                        <TextBlock Text="{Binding StateText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StateKind}" Value="good">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StateKind}" Value="attention">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Problem}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                                                   Visibility="{Binding HasProblem, Converter={StaticResource Visible}}" />
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" DisplayMemberPath="Label"
                                                              ItemsSource="{Binding DataContext.Options, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedItem="{Binding Choice, Mode=TwoWay}" IsEnabled="{Binding CanPick}"
                                                              AutomationProperties.Name="{Binding Name, StringFormat='Who {0} is in Helix or Procore'}" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <Button Content="Confirm" Click="ConfirmTeamRow_Click" Style="{StaticResource AccentButton}" MinWidth="78"
                                                                Visibility="{Binding CanConfirm, Converter={StaticResource Visible}}"
                                                                AutomationProperties.Name="{Binding Name, StringFormat='Confirm the link for {0}'}" />
                                                        <Button Content="Unlink" Click="UnlinkTeamRow_Click" Margin="8,0,0,0"
                                                                Visibility="{Binding CanUnlink, Converter={StaticResource Visible}}"
                                                                AutomationProperties.Name="{Binding Name, StringFormat='Unlink {0}'}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="BASE BUILD / TENANT FIT OUT" Style="{StaticResource SectionTitle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="PhaseWhole" GroupName="Phase" Content="Whole project" Checked="Phase_Changed" />
                                <RadioButton x:Name="PhaseBaseBuild" GroupName="Phase" Content="Base Build (BB)" Checked="Phase_Changed" />
                                <RadioButton x:Name="PhaseFitOut" GroupName="Phase" Content="Tenant Fit Out (TFO)" Checked="Phase_Changed" />
                            </StackPanel>
                            <StackPanel x:Name="PhaseOptions">
                                <CheckBox x:Name="FilterItemsBox" Margin="0,0,0,6">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="The Helix/Procore project also holds the other part: only include items whose title, number or contract says this part." />
                                </CheckBox>
                                <CheckBox x:Name="FilterFoldersBox" Margin="0,0,0,6">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="The CA folders also hold the other part: only include folders whose name says this part." />
                                </CheckBox>
                                <CheckBox x:Name="IncludeUnlabeledBox" Margin="0,0,0,6">
                                    <TextBlock TextWrapping="Wrap" Text="Also include items and folders that mention neither BB nor TFO." />
                                </CheckBox>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"
                                       Text="Recognised words: BB, Base Build, Base Building · TFO, Tenant Fit Out, Fit-Out, Tenant Improvement. If each part has its own Helix/Procore project or its own folders, link or Browse to those instead and leave the boxes unchecked." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="RETURNED MEANS OUT OF THIS COMPANY'S COURT" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Choose your company:" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                            <ListBox x:Name="CompanyList" MaxHeight="150" DisplayMemberPath="Label"
                                     Background="{DynamicResource InputBackground}" BorderThickness="1"
                                     BorderBrush="{DynamicResource LineBrush}"
                                     AutomationProperties.Name="Your company" />
                            <TextBlock x:Name="CompanyNote" Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12"
                                       Text="The other companies on this project appear here after its first sync." />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12"
                                       Text="When an item counts as returned is set for every project in Settings → General." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="FOLDER NAMES" Style="{StaticResource SectionTitle}" />
                            <CheckBox x:Name="OverrideFoldersBox" Content="Use different folder names for this project"
                                      Checked="OverrideFolders_Changed" Unchecked="OverrideFolders_Changed" Margin="0,0,0,8" />
                            <Grid x:Name="OverrideGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="RFI folder" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="RfiBox" Margin="0,0,0,6" VerticalContentAlignment="Center" />
                                <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Click="BrowseRfi_Click" Margin="8,0,0,6" />
                                <TextBlock Grid.Row="1" Text="Submittal folder" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SubmittalBox" Margin="0,0,0,6" VerticalContentAlignment="Center" />
                                <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Click="BrowseSubmittal_Click" Margin="8,0,0,6" />
                                <TextBlock Grid.Row="2" Text="Returned subfolder" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ReturnedBox" VerticalContentAlignment="Center" />
                                <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Click="BrowseReturned_Click" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock x:Name="FolderNote" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                       Text="Folders inside the CA folder are saved relative to it; folders elsewhere are saved as full paths. Returned is looked for inside each of the RFI and Submittal folders." />
                        </StackPanel>
                    </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button x:Name="RemoveButton" DockPanel.Dock="Left" Content="Remove from tracker…" Click="Remove_Click" />
                <TextBlock x:Name="ErrorText" DockPanel.Dock="Left" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="420" Margin="12,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="SavedText" Text="Saved" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                               Margin="0,0,12,0" Visibility="Collapsed" />
                    <TextBlock x:Name="UnsavedText" Text="Unsaved changes" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                               Margin="0,0,12,0" Visibility="Collapsed" />
                    <Button x:Name="CloseButton" Content="Close" Click="Close_Click" Margin="0,0,8,0" ToolTip="Back to the projects (Esc)" />
                    <Button x:Name="SaveCloseButton" Content="Save and close" Click="SaveAndClose_Click" Margin="0,0,8,0" />
                    <Button x:Name="SaveButton" Content="_Save" Style="{StaticResource AccentButton}" Click="Save_Click" MinWidth="80"
                            ToolTip="Save and keep editing (Ctrl+S)" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
