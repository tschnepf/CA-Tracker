<Window x:Class="SmcCaTracker.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CA Tracker settings"
        Width="720" Height="760" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <!-- Appearance -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="APPEARANCE" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Match Windows" Checked="Theme_Checked" />
                            <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light" Checked="Theme_Checked" />
                            <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark" Checked="Theme_Checked" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Folder names -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="DEFAULT FOLDER NAMES INSIDE EACH CA FOLDER" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="RFI folder" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="RfiFolderBox" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="1" Text="Submittal folder" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="SubmittalFolderBox" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Text="Returned subfolder" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ReturnedFolderBox" />
                        </Grid>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12"
                                   Text="Example: CA\RFIs\~Returned. Renaming here does not rename any folders on disk." />
                    </StackPanel>
                </Border>

                <!-- Returned rule -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="WHEN IS AN ITEM RETURNED?" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="WhenNotHeldBox" Content="No one from the selected company holds it (default)" Margin="0,0,0,6" />
                        <CheckBox x:Name="WhenClosedBox" Content="It is closed, complete, or voided" Margin="0,0,0,6" />
                        <CheckBox x:Name="WhenComingUpBox" Content="Also when the company only has a later review step (coming up)" Margin="0,0,0,10" />
                        <TextBlock Text="Always treat these statuses as returned (comma-separated)" Foreground="{DynamicResource TextSecondary}" />
                        <TextBox x:Name="AlwaysStatusesBox" Margin="0,4,0,8" />
                        <TextBlock Text="Never treat these statuses as returned (comma-separated)" Foreground="{DynamicResource TextSecondary}" />
                        <TextBox x:Name="NeverStatusesBox" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Chrome -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CHROME" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Chrome program (leave empty to find it automatically)" Foreground="{DynamicResource TextSecondary}" />
                        <DockPanel Margin="0,4,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseChrome_Click" Margin="8,0,0,0" />
                            <TextBox x:Name="ChromePathBox" VerticalContentAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="ChromeFoundText" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" />
                        <TextBlock Text="Chrome profile folder (optional, e.g. Default or Profile 1)" Foreground="{DynamicResource TextSecondary}" />
                        <TextBox x:Name="ProfileBox" Margin="0,4,0,8" />
                        <CheckBox x:Name="CloseTabBox" Content="Close the Chrome tab when a refresh finishes" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Stop waiting for Chrome after" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="TimeoutBox" Width="60" />
                            <TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="EXTENSION CONNECTION" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="RegistrationText" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="Allowed extension IDs (comma-separated)" Foreground="{DynamicResource TextSecondary}" />
                        <TextBox x:Name="ExtensionIdsBox" Margin="0,4,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Register with Chrome" Click="Register_Click" Margin="0,0,8,0" />
                            <Button Content="Remove registration" Click="Unregister_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" FontSize="12"
                                   Text="Registration is for your Windows user only and changes no project folders. Then enable the Windows helper in the SMC-CA-Tracker extension's settings." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="20,12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource SurfaceBackground}">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="ErrorText" DockPanel.Dock="Left" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="420" />
                <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click" />
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
