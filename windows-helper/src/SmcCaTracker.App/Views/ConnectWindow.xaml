<Window x:Class="SmcCaTracker.App.Views.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to Helix or Procore"
        Width="640" Height="640" MinWidth="500" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="HelixOption" GroupName="Provider" Style="{StaticResource SegmentButton}" Content="Helix"
                         Checked="Provider_Checked" />
            <RadioButton x:Name="ProcoreOption" GroupName="Provider" Style="{StaticResource SegmentButton}" Content="Procore"
                         Checked="Provider_Checked" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Search" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{DynamicResource TextSecondary}" />
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" VerticalContentAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <ListBox x:Name="ProjectList" MouseDoubleClick="ProjectList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" Margin="10" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Or paste the project's link" Foreground="{DynamicResource TextSecondary}" />
            <TextBox x:Name="LinkBox" Margin="0,4,0,4" />
            <TextBlock Style="{StaticResource Muted}" FontSize="12"
                       Text="Helix: the project's Overview page. Procore: the project's RFIs tool (it includes the company)." />
            <Button x:Name="OpenSiteButton" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenSite_Click" />
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="ErrorText" DockPanel.Dock="Left" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="360" />
            <Button DockPanel.Dock="Right" Content="Connect" Style="{StaticResource AccentButton}" IsDefault="True" Click="Connect_Click" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
        </DockPanel>
    </Grid>
</Window>
