<UserControl x:Class="SmcCaTracker.App.Views.ItemPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Border Style="{StaticResource Card}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Margin="8,0,0,0" VerticalAlignment="Top"
                            ToolTip="Close the item (CA Tracker checks the project once more for changes you made here)" />
                    <Button x:Name="RetryButton" DockPanel.Dock="Right" Content="Open the item again" Click="Retry_Click"
                            Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Top" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeadingText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <wv2:WebView2 x:Name="Browser" Grid.Row="1" />
        </Grid>
    </Border>
</UserControl>
