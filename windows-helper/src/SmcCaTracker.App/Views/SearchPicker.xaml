<UserControl x:Class="SmcCaTracker.App.Views.SearchPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" MinWidth="110">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid>
        <!-- Drawn like the theme's ComboBox, with a text box where the choice shows. -->
        <Border x:Name="Chrome" Background="{DynamicResource InputBackground}" BorderThickness="1" CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Root}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <TextBox x:Name="Input" Background="Transparent" BorderThickness="0" Padding="8,5,28,5" VerticalContentAlignment="Center"
                         AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}"
                         TextChanged="Input_TextChanged" PreviewKeyDown="Input_PreviewKeyDown" LostFocus="Input_LostFocus"
                         GotKeyboardFocus="Input_GotKeyboardFocus" PreviewMouseLeftButtonDown="Input_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="Input_PreviewMouseLeftButtonUp" />
                <TextBlock x:Name="PlaceholderText" Text="{Binding Placeholder, ElementName=Root}" IsHitTestVisible="False" Margin="11,0,28,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                <Button x:Name="DropButton" HorizontalAlignment="Right" Width="28" Focusable="False" Cursor="Hand"
                        Click="DropButton_Click" AutomationProperties.Name="Show the list">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"
                                      Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
        <Popup x:Name="ListPopup" PlacementTarget="{Binding ElementName=Chrome}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" Closed="ListPopup_Closed">
            <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,2,0,0"
                    MinWidth="{Binding ActualWidth, ElementName=Chrome}">
                <Grid>
                    <ListBox x:Name="List" Focusable="False" MaxHeight="340" DisplayMemberPath="{Binding DisplayMemberPath, ElementName=Root}"
                             VirtualizingPanel.IsVirtualizing="False" ScrollViewer.CanContentScroll="False"
                             PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock x:Name="NoMatchText" Margin="10,6" Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
