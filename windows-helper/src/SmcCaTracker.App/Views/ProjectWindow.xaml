<Window x:Class="SmcCaTracker.App.Views.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project"
        Width="680" Height="720" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="PROJECT" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Name" Foreground="{DynamicResource TextSecondary}" />
                        <TextBox x:Name="NameBox" Margin="0,4,0,10" />
                        <TextBlock Text="CA folder" Foreground="{DynamicResource TextSecondary}" />
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="Change…" Click="BrowseFolder_Click" Margin="8,0,0,0" />
                            <TextBox x:Name="FolderBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12"
                                   Text="Choosing a folder only records it in the tracker. Nothing in the folder changes." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="CONNECTION" Style="{StaticResource SectionTitle}" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Connect…" Click="Connect_Click" Margin="8,0,0,0" />
                                <Button x:Name="DisconnectButton" Content="Disconnect" Click="Disconnect_Click" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="ConnectionText" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12"
                                   Text="Connect the project to Helix or Procore so Refresh can read its RFIs and Submittals." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="BASE BUILD / TENANT FIT OUT" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="PhaseWhole" GroupName="Phase" Content="Whole project" Checked="Phase_Changed" />
                            <RadioButton x:Name="PhaseBaseBuild" GroupName="Phase" Content="Base Build (BB)" Checked="Phase_Changed" />
                            <RadioButton x:Name="PhaseFitOut" GroupName="Phase" Content="Tenant Fit Out (TFO)" Checked="Phase_Changed" />
                        </StackPanel>
                        <StackPanel x:Name="PhaseOptions">
                            <CheckBox x:Name="FilterItemsBox" Margin="0,0,0,6">
                                <TextBlock TextWrapping="Wrap"
                                           Text="The Helix/Procore project also holds the other part: only include items whose title, number or contract says this part." />
                            </CheckBox>
                            <CheckBox x:Name="FilterFoldersBox" Margin="0,0,0,6">
                                <TextBlock TextWrapping="Wrap"
                                           Text="The CA folders also hold the other part: only include folders whose name says this part." />
                            </CheckBox>
                            <CheckBox x:Name="IncludeUnlabeledBox" Margin="0,0,0,6">
                                <TextBlock TextWrapping="Wrap" Text="Also include items and folders that mention neither BB nor TFO." />
                            </CheckBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"
                                   Text="Recognised words: BB, Base Build, Base Building · TFO, Tenant Fit Out, Fit-Out, Tenant Improvement. If each part has its own Helix/Procore project or its own folders, connect or Browse to those instead and leave the boxes unticked." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="RETURNED MEANS OUT OF THIS COMPANY'S COURT" Style="{StaticResource SectionTitle}" />
                        <ListBox x:Name="CompanyList" MaxHeight="150" DisplayMemberPath="Label"
                                 Background="{DynamicResource InputBackground}" BorderThickness="1"
                                 BorderBrush="{DynamicResource LineBrush}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12"
                                   Text="Companies appear here after the first refresh." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FOLDER NAMES" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="OverrideFoldersBox" Content="Use different folder names for this project"
                                  Checked="OverrideFolders_Changed" Unchecked="OverrideFolders_Changed" Margin="0,0,0,8" />
                        <Grid x:Name="OverrideGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="RFI folder" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="RfiBox" Margin="0,0,0,6" VerticalContentAlignment="Center" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Click="BrowseRfi_Click" Margin="8,0,0,6" />
                            <TextBlock Grid.Row="1" Text="Submittal folder" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="SubmittalBox" Margin="0,0,0,6" VerticalContentAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Click="BrowseSubmittal_Click" Margin="8,0,0,6" />
                            <TextBlock Grid.Row="2" Text="Returned subfolder" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ReturnedBox" VerticalContentAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Click="BrowseReturned_Click" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock x:Name="FolderNote" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                   Text="Folders inside the CA folder are saved relative to it; folders elsewhere are saved as full paths. Returned is looked for inside each of the RFI and Submittal folders." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="20,12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource SurfaceBackground}">
            <DockPanel LastChildFill="False">
                <Button x:Name="RemoveButton" DockPanel.Dock="Left" Content="Remove from tracker…" Click="Remove_Click" />
                <TextBlock x:Name="ErrorText" DockPanel.Dock="Left" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="300" Margin="12,0,0,0" />
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save" Style="{StaticResource AccentButton}"
                        IsDefault="True" Click="Save_Click" />
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
