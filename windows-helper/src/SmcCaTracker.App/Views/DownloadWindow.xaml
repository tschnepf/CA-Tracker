<Window x:Class="SmcCaTracker.App.Views.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Download — CA Tracker"
        Width="900" Height="640" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ListRow" Height="*" />
            <RowDefinition x:Name="BrowserRow" Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
            <DockPanel>
                <Button x:Name="ChangeButton" DockPanel.Dock="Right" Content="Change…" Click="Change_Click" VerticalAlignment="Center" />
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="SAVE TO" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="DestinationText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DestinationNote" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid x:Name="FilesGrid" Grid.Row="2" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="40" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanChange}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Uploaded" Binding="{Binding UploadedText}" Width="150" SortMemberPath="UploadedAt" />
                <DataGridTextColumn Header="Saved as" Binding="{Binding TargetName}" Width="2*" />
                <DataGridTextColumn Header="" Binding="{Binding StatusText}" Width="1.3*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Only shown when Helix asks you to sign in. -->
        <wv2:WebView2 x:Name="Browser" Grid.Row="3" />

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="AllButton" DockPanel.Dock="Left" Content="Select all" Click="All_Click" Margin="0,0,6,0" />
            <Button x:Name="NoneButton" DockPanel.Dock="Left" Content="Select none" Click="None_Click" />
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Cancel" Click="Close_Click" />
            <!-- Downloading several checked items: stops before the rest. -->
            <Button x:Name="StopBatchButton" DockPanel.Dock="Right" Content="Stop" Click="StopBatch_Click" Margin="0,0,8,0"
                    Visibility="Collapsed" ToolTip="Don't go on to the remaining checked items" />
            <Button x:Name="DownloadButton" DockPanel.Dock="Right" Content="Download" Style="{StaticResource AccentButton}"
                    Click="Download_Click" Margin="0,0,8,0" IsEnabled="False" />
            <Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Content="Open folder" Click="OpenFolder_Click"
                    Margin="0,0,8,0" Visibility="Collapsed" />
        </DockPanel>
    </Grid>
</Window>
