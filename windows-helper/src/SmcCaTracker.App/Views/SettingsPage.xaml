<UserControl x:Class="SmcCaTracker.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shown in place of the project list. DataContext is the main window's MainViewModel. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="SETTINGS" Style="{StaticResource SectionTitle}" Margin="6,4,0,8" />
                <Button DockPanel.Dock="Bottom" Content="← Back to projects" Click="Back_Click" Margin="4,8,4,2" />
                <ListBox x:Name="SectionList" SelectionChanged="Section_Changed">
                    <ListBoxItem x:Name="GeneralItem" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="General settings" FontWeight="SemiBold" />
                            <TextBlock Text="Appearance, folders, returned rule, refresh" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="ConnectionsItem" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Connections" FontWeight="SemiBold" />
                            <TextBlock Text="Helix and Procore sign-in and sync" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- General settings -->
        <Grid x:Name="GeneralPanel" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                        <TextBlock Text="{Binding ManagedByText}" TextWrapping="Wrap" Margin="2,0,0,12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Visibility="{Binding HasManagedByText, Converter={StaticResource Visible}}" />
                        <!-- Appearance -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Match Windows" Checked="Theme_Checked" />
                                    <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light" Checked="Theme_Checked" />
                                    <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark" Checked="Theme_Checked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Folder names -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="DEFAULT FOLDER NAMES INSIDE EACH CA FOLDER" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="RFI folder" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="RfiFolderBox" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="1" Text="Submittal folder" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="SubmittalFolderBox" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="2" Text="Returned subfolder" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="ReturnedFolderBox" />
                                </Grid>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12"
                                           Text="Example: CA\RFIs\~Returned. Renaming here does not rename any folders on disk." />
                            </StackPanel>
                        </Border>

                        <!-- Returned rule -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="WHEN IS AN ITEM RETURNED?" Style="{StaticResource SectionTitle}" />
                                <CheckBox x:Name="WhenNotHeldBox" Content="No one from the selected company holds it (default)" Margin="0,0,0,6" />
                                <CheckBox x:Name="WhenClosedBox" Content="It is closed, complete, or voided" Margin="0,0,0,6" />
                                <CheckBox x:Name="WhenComingUpBox" Content="Also when the company only has a later review step (coming up)" Margin="0,0,0,10" />
                                <TextBlock Text="Always treat these statuses as returned (comma-separated)" Foreground="{DynamicResource TextSecondary}" />
                                <TextBox x:Name="AlwaysStatusesBox" Margin="0,4,0,8" />
                                <TextBlock Text="Never treat these statuses as returned (comma-separated)" Foreground="{DynamicResource TextSecondary}" />
                                <TextBox x:Name="NeverStatusesBox" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Refresh -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="REFRESH" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Helix and Procore are read in the background, without opening a window. Sign in once in Connections; it remembers you. Procore projects in every company you belong to are found and synced by themselves — right-click a project to stop syncing it." />
                                <CheckBox x:Name="AutoSyncBox" Content="Keep Helix and Procore projects up to date in the background" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="24,0,0,10">
                                    <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="SyncIntervalBox" Width="60" />
                                    <TextBlock Text="minutes (only changed items are read)" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="CloseWindowBox" Content="Close the browser window when a refresh finishes" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Stop waiting after" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="TimeoutBox" Width="60" />
                                    <TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Sign out of the built-in browser…" Click="ClearBrowser_Click" Margin="0,0,8,0" />
                                    <Button Content="Open the log folder" Click="OpenLogs_Click" Margin="0,0,8,0"
                                            ToolTip="Timings and errors, one file per day. Useful when something is slow or fails." />
                                    <Button Content="Export a Helix test sample" Click="ExportSample_Click"
                                            ToolTip="Saves an anonymized copy of the selected Helix project's items (names, companies and titles replaced) so wrong 'whose court' results can become test cases." />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,10">
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="ErrorText" DockPanel.Dock="Left" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="460" />
                    <TextBlock x:Name="SavedText" DockPanel.Dock="Left" Text="Saved." Foreground="{DynamicResource SuccessBrush}"
                               VerticalAlignment="Center" Visibility="Collapsed" />
                    <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource AccentButton}" Click="Save_Click" />
                    <Button DockPanel.Dock="Right" Content="Discard changes" Click="Discard_Click" Margin="0,0,8,0" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Connections -->
        <ScrollViewer x:Name="ConnectionsPanel" Grid.Column="2" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,0,0,12"
                           Text="Connect signs you in to Helix or Procore in CA Tracker's own browser, once. Syncing then happens in the background with that sign-in. For Procore, CA Tracker finds every project you can see in every company (including projects hosted by other companies) — no links to paste and nothing to install in anyone's Procore account." />
                <ItemsControl ItemsSource="{Binding Connections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="170">
                                        <Button Content="{Binding ConnectButtonText}" Click="Connect_Click" Style="{StaticResource AccentButton}" />
                                        <Button Content="Sync now" Click="Sync_Click" Margin="0,8,0,0"
                                                IsEnabled="{Binding CanSync}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding LastSyncedText}" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding ProjectsText}" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding SyncMessage}" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"
                                                   TextWrapping="Wrap" Visibility="{Binding HasSyncMessage, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Company server (optional) -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="COMPANY SERVER (OPTIONAL)" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="With your company's CA Tracker server, everyone shares what they read from Helix and Procore and the discipline choices made for each project. Your CA folder locations stay on this PC. Without it, everything stays on this PC." />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Server address" VerticalAlignment="Center" />
                            <TextBox x:Name="CentralServerBox" Grid.Column="1" Margin="0,0,0,6"
                                     ToolTip="For example https://workload.yourcompany.com" />
                            <TextBlock Grid.Row="1" Text="Access token" VerticalAlignment="Center" />
                            <PasswordBox x:Name="CentralTokenBox" Grid.Row="1" Grid.Column="1"
                                         ToolTip="From the server's administrator. Leave empty to keep the token already saved. It is stored encrypted for your Windows user." />
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save and connect" Click="SaveCentral_Click" Margin="0,0,8,0" />
                            <Button Content="Share now" Click="ShareCentral_Click" Margin="0,0,8,0" />
                            <Button Content="Disconnect" Click="DisconnectCentral_Click" />
                        </StackPanel>
                        <TextBlock Text="{Binding CentralStatusText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="CentralMessage" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
