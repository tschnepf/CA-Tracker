<UserControl x:Class="SmcCaTracker.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shown in place of the project list. DataContext is the main window's MainViewModel. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <!-- A field's problem, shown under it as you type. -->
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="← Back to projects" Click="Back_Click" Margin="4,2,4,10" />
                <TextBlock DockPanel.Dock="Top" Text="SETTINGS" Style="{StaticResource SectionTitle}" Margin="6,4,0,8" />
                <ListBox x:Name="SectionList" SelectionChanged="Section_Changed" AutomationProperties.Name="Settings sections">
                    <ListBoxItem x:Name="GeneralItem" Padding="10,8" AutomationProperties.Name="General settings">
                        <StackPanel>
                            <TextBlock Text="General settings" FontWeight="SemiBold" />
                            <TextBlock Text="Appearance, folders, returned rule, background sync, troubleshooting" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="ConnectionsItem" Padding="10,8" AutomationProperties.Name="Connections">
                        <StackPanel>
                            <TextBlock Text="Connections" FontWeight="SemiBold" />
                            <TextBlock Text="Helix, Procore and company server" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- General settings -->
        <Grid x:Name="GeneralPanel" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding ManagedByText}" TextWrapping="Wrap" Margin="2,0,0,12"
                               Foreground="{DynamicResource TextSecondary}"
                               Visibility="{Binding HasManagedByText, Converter={StaticResource Visible}}" />
                    <!-- Appearance: applied and saved as soon as it's picked. -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionTitle}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Match Windows" Checked="Theme_Checked" />
                                <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light" Checked="Theme_Checked" />
                                <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark" Checked="Theme_Checked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Folder names -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="DEFAULT FOLDER NAMES INSIDE EACH CA FOLDER" Style="{StaticResource SectionTitle}" />
                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="320" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="RFI folder" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="RfiFolderBox" Margin="0,0,0,6" AutomationProperties.Name="RFI folder" />
                                <TextBlock Grid.Row="1" Text="Submittal folder" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SubmittalFolderBox" Margin="0,0,0,6" AutomationProperties.Name="Submittal folder" />
                                <TextBlock Grid.Row="2" Text="Returned subfolder" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ReturnedFolderBox" AutomationProperties.Name="Returned subfolder" />
                            </Grid>
                            <TextBlock x:Name="FoldersError" Style="{StaticResource FieldError}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12"
                                       Text="Example: CA\RFIs\~Returned. Renaming here does not rename any folders on disk. A project can use its own names in Edit project → Folder names." />
                        </StackPanel>
                    </Border>

                    <!-- Returned rule -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="WHEN IS AN ITEM RETURNED?" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"
                                       Text="For every project. Each project's company is chosen in Edit project." />
                            <CheckBox x:Name="WhenNotHeldBox" Content="No one from your company holds it (default)" Margin="0,0,0,6" />
                            <CheckBox x:Name="WhenClosedBox" Content="It is closed, complete, or voided" Margin="0,0,0,6" />
                            <CheckBox x:Name="WhenComingUpBox" Content="Also when your company only has a review step coming up later" Margin="0,0,0,10" />
                            <TextBlock Text="Always treat these statuses as returned (comma-separated, spelled as in Helix or Procore)"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="620" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AlwaysStatusesBox" AutomationProperties.Name="Always treat these statuses as returned"
                                         ToolTip="For example: Closed, Void" />
                            </Grid>
                            <TextBlock Text="Never treat these statuses as returned (comma-separated)" Foreground="{DynamicResource TextSecondary}" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="620" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NeverStatusesBox" AutomationProperties.Name="Never treat these statuses as returned"
                                         ToolTip="For example: Draft" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Background sync -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="BACKGROUND SYNC" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Helix and Procore are read in the background with your sign-in from Connections. Every Procore project you can see is found by itself; right-click a project to stop syncing it." />
                            <CheckBox x:Name="AutoSyncBox" Content="Keep Helix and Procore projects up to date in the background" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="SyncIntervalBox" Width="60" AutomationProperties.Name="Sync every how many minutes" />
                                <TextBlock Text="minutes (5–240; only changed items are read)" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="IntervalError" Style="{StaticResource FieldError}" Margin="24,4,0,0" />

                            <TextBlock Text="WHEN PROCORE NEEDS THE BROWSER WINDOW" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                            <CheckBox x:Name="CloseWindowBox" Content="Close the window when the sync finishes" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Give up after" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="TimeoutBox" Width="60" AutomationProperties.Name="Give up after how many seconds" />
                                <TextBlock Text="seconds (30–1800)" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="TimeoutError" Style="{StaticResource FieldError}" />
                        </StackPanel>
                    </Border>

                    <!-- Troubleshooting -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="TROUBLESHOOTING" Style="{StaticResource SectionTitle}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="Open the log folder" Click="OpenLogs_Click" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Text="Timings and errors, one file per day. Send today's file along when something is slow or fails." />
                            </DockPanel>
                            <Expander Header="Developer tools" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondary}">
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Left" Content="Export a Helix test sample" Click="ExportSample_Click" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Text="Saves an anonymized copy of the selected Helix project's items (names, companies and titles replaced), so a wrong ball-in-court result can become a test case." />
                                </DockPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <!-- Save bar. Buttons are declared in the order Tab visits them. -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,10">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="DiscardButton" Content="Discard changes" Click="Discard_Click" Margin="0,0,8,0" IsEnabled="False" />
                        <Button x:Name="SaveButton" Content="_Save" Style="{StaticResource AccentButton}" Click="Save_Click" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" DockPanel.Dock="Left" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="520" />
                    <TextBlock x:Name="SavedText" DockPanel.Dock="Left" Text="Saved." Foreground="{DynamicResource SuccessBrush}"
                               VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock x:Name="UnsavedText" DockPanel.Dock="Left" Text="Unsaved changes" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" Visibility="Collapsed" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Connections -->
        <ScrollViewer x:Name="ConnectionsPanel" Grid.Column="2" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,0,0,12"
                           Text="Sign in once to Helix and Procore in CA Tracker's own browser. CA Tracker then keeps your projects up to date in the background. For Procore, every project you can see, in every company, is found by itself." />
                <ItemsControl ItemsSource="{Binding Connections}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="170">
                                        <Button Content="{Binding ConnectButtonText}" Click="Connect_Click" Style="{StaticResource SignInButton}" />
                                        <Button Content="Sync now" Click="Sync_Click" Margin="0,8,0,0"
                                                IsEnabled="{Binding CanSync}" ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Sync every project from this site now (sign in first)"
                                                Visibility="{Binding IsNotSyncing, Converter={StaticResource Visible}}" />
                                        <Button Content="Stop" Click="Stop_Click" Margin="0,8,0,0"
                                                ToolTip="Finish the project being synced and skip the rest"
                                                Visibility="{Binding IsSyncing, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource ConnectionBadge}" Margin="10,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource ConnectionGlyph}" RenderTransformOrigin="0.5,0.55">
                                                        <TextBlock.RenderTransform>
                                                            <RotateTransform Angle="0" />
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LastSyncedText}" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding ProjectsText}" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        <!-- While it reads: how far along (sliding while it is still finding projects or waiting its turn). -->
                                        <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsProgressUnknown, Mode=OneWay}"
                                                     Maximum="100" Height="4" Margin="0,10,0,0" BorderThickness="0"
                                                     Background="{DynamicResource LineBrush}" Foreground="{DynamicResource AccentBrush}"
                                                     AutomationProperties.Name="Sync progress"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding SyncMessage}" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"
                                                   TextWrapping="Wrap" Visibility="{Binding HasSyncMessage, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding FailedText}" Foreground="{DynamicResource WarningBrush}" Margin="0,6,0,0"
                                                   TextWrapping="Wrap" Visibility="{Binding HasFailedText, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The built-in browser's sign-ins -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Sign out of Helix and Procore…" Click="ClearBrowser_Click"
                                VerticalAlignment="Center" Margin="16,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="SIGN OUT" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="Signs CA Tracker's own browser out of both sites (your web browser isn't affected). Sign in again above to keep syncing." />
                            <TextBlock x:Name="SignOutMessage" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Company server (optional) -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="COMPANY SERVER (OPTIONAL)" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="With your company's CA Tracker server, everyone shares what they read from Helix and Procore and the discipline choices made for each project. Your CA folder locations stay on this PC. Without it, everything stays on this PC." />
                        <Grid Margin="0,0,0,8" MaxWidth="720" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="460" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Server address" VerticalAlignment="Center" />
                            <TextBox x:Name="CentralServerBox" Grid.Column="1" AutomationProperties.Name="Server address" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,6"
                                       Text="For example https://workload.yourcompany.com" />
                            <TextBlock Grid.Row="2" Text="Access token" VerticalAlignment="Center" />
                            <PasswordBox x:Name="CentralTokenBox" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="Access token" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="From the server's administrator. Leave it empty to keep the token already saved; it is stored encrypted for your Windows user." />
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save and connect" Click="SaveCentral_Click" Margin="0,0,8,0" />
                            <Button Content="Share now" Click="ShareCentral_Click" Margin="0,0,8,0" IsEnabled="{Binding IsCentralSetUp}" />
                            <Button Content="Disconnect…" Click="DisconnectCentral_Click" IsEnabled="{Binding IsCentralSetUp}" />
                        </StackPanel>
                        <!-- One status line: what just happened, or else how sharing stands. -->
                        <TextBlock x:Name="CentralStatus" Text="{Binding CentralStatusText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="CentralMessage" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
