<Window x:Class="SmcCaTracker.App.Views.WatchlistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Watchlist — CA Tracker"
        Width="1200" Height="760" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondary}" />
            <TextBox x:Name="NameBox" Width="320" HorizontalAlignment="Left" AutomationProperties.Name="Watchlist name" />
        </DockPanel>

        <!-- Two columns: the projects it covers (find one by typing), and who is watched on each. -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" MaxWidth="560" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="PROJECTS" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProjectCountText" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,8"
                           Text="Check the projects this watchlist covers; each gets a column of people." />
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBox x:Name="ProjectSearchBox" TextChanged="ProjectSearch_Changed" AutomationProperties.Name="Find a project" />
                    <TextBlock x:Name="ProjectSearchHint" Text="Find a project" Foreground="{DynamicResource TextMuted}" Margin="9,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource SurfaceBackground}">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4">
                            <ItemsControl x:Name="ProjectChoices" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,4" Click="ProjectCheck_Click"
                                                  ToolTip="{Binding Name, StringFormat={}{0} (Shift-click another to check every project between)}">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="NoProjectsText" Style="{StaticResource Muted}" Margin="12" VerticalAlignment="Top"
                                   Text="No project names contain that. Clear the box to see them all." Visibility="Collapsed" />
                    </Grid>
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" Cursor="SizeWE" ToolTip="Drag to resize the project list" />

            <!-- The people: find one, and keep to each project's own company. -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="PEOPLE" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                               Text="Under each box: what they hold there now." />
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,8,0,8" LastChildFill="False">
                    <Grid DockPanel.Dock="Left" Width="240">
                        <TextBox x:Name="SearchBox" TextChanged="Search_Changed" AutomationProperties.Name="Find a person" />
                        <TextBlock x:Name="SearchHint" Text="Find a person" Foreground="{DynamicResource TextMuted}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <CheckBox x:Name="OursOnlyBox" DockPanel.Dock="Left" Content="Only people from the project's company" IsChecked="True"
                              Margin="14,0,0,0" VerticalAlignment="Center" Click="OursOnly_Click"
                              ToolTip="People checked already always stay listed" />
                </DockPanel>
                <Grid>
                    <DataGrid x:Name="PeopleGrid" IsReadOnly="True" SelectionMode="Single" RowHeight="42"
                              HorizontalScrollBarVisibility="Auto" FrozenColumnCount="1" AutomationProperties.Name="People and projects" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" MaxWidth="420" Visibility="Collapsed" />
                </Grid>
            </DockPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" />
                <Button Content="_Save" Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click" />
            </StackPanel>
            <Button x:Name="DeleteButton" DockPanel.Dock="Left" Content="Delete watchlist…" Click="Delete_Click" Margin="0,0,14,0" Visibility="Collapsed" />
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
