<UserControl x:Class="SmcCaTracker.App.Views.PeoplePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SmcCaTracker.App.Views">
    <!-- Settings → People: link the Helix and Procore people CA Tracker sees to Workload Tracker people. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="PEOPLE" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Link the people CA Tracker sees in Helix and Procore to the people in Workload Tracker, so the items in their court show on their My Work. A name that matches someone on the project's team is suggested; nothing is linked until you confirm it. Links are kept in Workload Tracker, for everyone." />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Project" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextSecondary}" />
                    <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="_Refresh" Click="Refresh_Click" Margin="8,0,0,0" />
                    <ComboBox x:Name="ProjectBox" DisplayMemberPath="Label" SelectionChanged="Project_Changed" MinWidth="260"
                              AutomationProperties.Name="Project" />
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" x:Name="ConfirmAllButton" Click="ConfirmAll_Click" Style="{StaticResource AccentButton}"
                            Visibility="Collapsed" />
                    <CheckBox x:Name="YourCompanyBox" IsChecked="True" Checked="Filter_Changed" Unchecked="Filter_Changed" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="ProblemText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="PeopleList" AutomationProperties.Name="People">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                            <ColumnDefinition Width="290" />
                                            <ColumnDefinition Width="170" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StateText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateKind}" Value="good">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StateKind}" Value="attention">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Problem}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                                       Visibility="{Binding HasProblem, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <views:SearchPicker ItemsSource="{Binding DataContext.Options, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                SelectedItem="{Binding Choice, Mode=TwoWay}" DisplayMemberPath="Label"
                                                                IsEnabled="{Binding CanPick}" Placeholder="Type a name…"
                                                                AutomationProperties.Name="{Binding Name, StringFormat='Workload Tracker person for {0}'}" />
                                            <Button Style="{StaticResource LinkButton}" Content="Someone else…" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                    Click="SomeoneElse_Click" IsEnabled="{Binding CanPick}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Find someone else for {0}'}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Button Content="Confirm" Click="Confirm_Click" Style="{StaticResource AccentButton}" MinWidth="78"
                                                    Visibility="{Binding CanConfirm, Converter={StaticResource Visible}}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Confirm the link for {0}'}" />
                                            <Button Content="Unlink" Click="Unlink_Click" Margin="8,0,0,0"
                                                    Visibility="{Binding CanUnlink, Converter={StaticResource Visible}}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Unlink {0}'}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" Margin="10" VerticalAlignment="Top" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
