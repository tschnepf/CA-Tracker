<Window x:Class="SmcCaTracker.App.Views.OpenFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Open — CA Tracker"
        Width="560" Height="210" MinWidth="460" MinHeight="190"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="BrowserRow" Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="StatusText" Grid.Row="1" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
        <ProgressBar x:Name="Progress" Grid.Row="2" IsIndeterminate="True" Height="4" Margin="0,12,0,0"
                     BorderThickness="0" Background="{DynamicResource LineBrush}" Foreground="{DynamicResource AccentBrush}" />

        <!-- Shown only when Helix asks you to sign in. Otherwise it keeps a 1-pixel row (so it starts and runs) but
             is hidden: a browser is drawn over the window, so even that row would show a sliver of the page. -->
        <wv2:WebView2 x:Name="Browser" Grid.Row="3" Visibility="Hidden" Margin="0,12,0,0" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" Content="Cancel" Click="Close_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
