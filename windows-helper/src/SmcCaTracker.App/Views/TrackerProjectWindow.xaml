<Window x:Class="SmcCaTracker.App.Views.TrackerProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose the Workload Tracker project"
        Width="600" Height="560" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Existing projects in Workload Tracker that are running (Active or Active CA). Search by number, name or client." />

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Search" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{DynamicResource TextSecondary}" />
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" VerticalContentAlignment="Center" AutomationProperties.Name="Search" />
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <ListBox x:Name="ProjectList" MouseDoubleClick="ProjectList_MouseDoubleClick" AutomationProperties.Name="Workload Tracker projects">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" Margin="10" VerticalAlignment="Top" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Button Grid.Row="3" x:Name="MoreButton" Content="Show more" HorizontalAlignment="Left" Margin="0,8,0,0"
                Click="More_Click" Visibility="Collapsed" />

        <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="ErrorText" DockPanel.Dock="Left" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="340" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="_Choose" Style="{StaticResource AccentButton}" IsDefault="True" Click="Choose_Click" MinWidth="80" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
