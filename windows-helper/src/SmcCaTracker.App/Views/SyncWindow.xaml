<Window x:Class="SmcCaTracker.App.Views.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync — CA Tracker"
        Width="560" SizeToContent="Height" MinHeight="260" MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Sync" FontSize="18" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14"
                   Text="Sync refreshes every project from that site, including ones without a CA folder yet, in the background. For Procore it first looks through every company you belong to for new projects. Projects set to not sync (right-click in the project list) are skipped, and a project that can't be read is marked and the rest carry on." />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Manage connections…" Click="Manage_Click" />
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Click="Close_Click" />
            <Button DockPanel.Dock="Right" Content="Sync all" Style="{StaticResource AccentButton}" Click="SyncAll_Click"
                    Margin="0,0,8,0" />
        </DockPanel>

        <StackPanel>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Visibility="{Binding HasNoListedConnections, Converter={StaticResource Visible}}"
                       Text="Nothing is connected yet. Select Manage connections… to connect to Helix or Procore." />
            <ItemsControl ItemsSource="{Binding Connections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                                Visibility="{Binding IsListed, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="110">
                                    <Button Content="Sync" Click="Sync_Click" IsEnabled="{Binding CanSync}"
                                            Visibility="{Binding IsNotSyncing, Converter={StaticResource Visible}}" />
                                    <Button Content="Stop" Click="Stop_Click"
                                            ToolTip="Finish the project being synced and skip the rest"
                                            Visibility="{Binding IsSyncing, Converter={StaticResource Visible}}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding LastSyncedText}" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ProjectsText}" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding SyncMessage}" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"
                                               TextWrapping="Wrap" Visibility="{Binding HasSyncMessage, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DockPanel>
</Window>
