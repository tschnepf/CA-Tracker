<Window x:Class="SmcCaTracker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmcCaTracker.App.Views"
        Title="SMC CA Tracker"
        Width="1280" Height="800" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource NeutralSoftBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="ReadyToReturn">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Reopened">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Ambiguous">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NotInProvider">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Filed">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar area -->
        <Border Grid.Row="0" Padding="20,14" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource SurfaceBackground}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="CA Tracker" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="Settings" Click="Settings_Click" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="{Binding UpdateText}" Click="InstallUpdate_Click" VerticalAlignment="Center"
                        Margin="0,0,8,0" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource Visible}}"
                        ToolTip="{Binding UpdateNotes}" />
                <Button DockPanel.Dock="Right" Content="Sync…" Click="Sync_Click" VerticalAlignment="Center" Margin="0,0,8,0"
                        Style="{StaticResource AccentButton}" MinWidth="90"
                        ToolTip="Sync your Helix and Procore connections: refresh every connected project" />
            </DockPanel>
        </Border>

        <views:SettingsPage x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" />

        <Grid x:Name="ProjectsPage" Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ProjectsColumn" Width="290" MinWidth="200" MaxWidth="700" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition x:Name="ListColumn" Width="*" MinWidth="420" />
                <ColumnDefinition x:Name="PanelSplitterColumn" Width="0" />
                <ColumnDefinition x:Name="ItemPanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Drag to resize the project list (the width is remembered). -->
            <GridSplitter x:Name="ProjectsSplitter" Grid.Column="1" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"
                          DragCompleted="ProjectsSplitter_DragCompleted" ToolTip="Drag to resize the project list" />

            <!-- The item panel: an opened Helix item, beside the list (drag the bar to resize). -->
            <GridSplitter x:Name="PanelSplitter" Grid.Column="3" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" Visibility="Collapsed"
                          ToolTip="Drag to resize the item panel" />
            <views:ItemPanel x:Name="ItemPanel" Grid.Column="4" Visibility="Collapsed" />

            <!-- Projects -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PROJECTS" Style="{StaticResource SectionTitle}" Margin="6,4,0,8" />
                    <!-- What is syncing now, then how the sync ended (hides after a little while). -->
                    <Border DockPanel.Dock="Top" Margin="4,0,4,8" Padding="8,6" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"
                            Visibility="{Binding IsSyncProgressVisible, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SyncProgressText}" FontSize="11.5" TextWrapping="Wrap" />
                            <ProgressBar Value="{Binding SyncProgressValue, Mode=OneWay}" Maximum="100" Height="3" Margin="0,5,0,0"
                                         BorderThickness="0" Background="{DynamicResource LineBrush}" Foreground="{DynamicResource AccentBrush}"
                                         Visibility="{Binding IsSyncProgressRunning, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Border>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource AccentButton}" Content="New project…"
                            Click="NewProject_Click" Margin="4,8,4,2" />
                    <CheckBox DockPanel.Dock="Bottom" Content="{Binding ShowArchivedText}" IsChecked="{Binding ShowArchived}"
                              Margin="6,8,4,0" Visibility="{Binding HasArchived, Converter={StaticResource Visible}}"
                              ToolTip="Archived projects are hidden and not synced, for you only. Check to show them (dimmed) and unarchive them." />
                    <Grid>
                        <ListBox x:Name="ProjectList" ItemsSource="{Binding Projects}" SelectionMode="Extended"
                                 SelectionChanged="ProjectList_SelectionChanged"
                                 ToolTip="Ctrl-click or Shift-click to show several projects' items together"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ContextMenuOpening="ProjectList_ContextMenuOpening">
                            <!-- Procore projects can be left out of syncing (they stay in the list). -->
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="FavoriteProjectMenu" Header="Add to favorites" Click="FavoriteProject_Click" />
                                    <MenuItem x:Name="UnfavoriteProjectMenu" Header="Remove from favorites" Click="UnfavoriteProject_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ArchiveProjectMenu" Header="Archive" Click="ArchiveProject_Click"
                                              ToolTip="Hide it from your list and stop syncing it. For you only: nothing changes in Helix, Procore or on the company server." />
                                    <MenuItem x:Name="UnarchiveProjectMenu" Header="Unarchive" Click="UnarchiveProject_Click" />
                                    <Separator x:Name="SyncMenuSeparator" />
                                    <MenuItem x:Name="SyncProjectMenu" Header="Sync this project" Click="SyncProject_Click" />
                                    <MenuItem x:Name="SkipProjectMenu" Header="Don't sync this project" Click="SkipProject_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <!-- Sections: projects with a CA folder, then Helix/Procore projects without one. -->
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="6,10,0,4">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="0" />
                                                <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" Style="{StaticResource SectionTitle}" Margin="0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding ListToolTip}">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSyncSkipped}" Value="True">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <DockPanel>
                                                <!-- Sync status: spinning while syncing, dot while waiting, check when done, ⚠ if it failed. -->
                                                <TextBlock DockPanel.Dock="Left" Margin="0,0,5,0" Width="12" TextAlignment="Center"
                                                           RenderTransformOrigin="0.5,0.55">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </TextBlock.RenderTransform>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SyncState}" Value="syncing">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Text" Value="⟳" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="SpinSync">
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                                                                 From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <StopStoryboard BeginStoryboardName="SpinSync" />
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SyncState}" Value="queued">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Text" Value="•" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SyncState}" Value="done">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Text" Value="✓" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SyncState}" Value="failed">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Text" Value="⚠" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock DockPanel.Dock="Left" Text="★" Margin="0,0,5,0" Foreground="{DynamicResource AccentBrush}"
                                                           Visibility="{Binding IsFavorite, Converter={StaticResource Visible}}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"
                                                Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasBadge, Converter={StaticResource Visible}}"
                                                ToolTip="Overdue | items matching the current filters (type, Open/All or folder view, people, due, discipline)">
                                            <!-- overdue | matching, e.g. "1 | 10" -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding OverdueText}" FontSize="11.5" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text=" | " FontSize="11.5" Foreground="{DynamicResource TextMuted}" />
                                                <TextBlock Text="{Binding BadgeText}" FontSize="11.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{StaticResource Muted}" Margin="8" VerticalAlignment="Top"
                                   Visibility="{Binding HasNoProjects, Converter={StaticResource Visible}}"
                                   Text="No projects yet. Select New project… and choose a project's CA folder, then connect it to Helix or Procore." />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Selected project -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="{Binding EditButtonText}" Click="EditProject_Click"
                                    VerticalAlignment="Top" IsEnabled="{Binding HasProject}" />
                            <TextBlock Text="{Binding ProjectTitle}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <Grid Margin="0,12,0,0" IsEnabled="{Binding HasProject}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="CA folder" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CaFolderText}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding CaFolderText}" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Open in Explorer" Click="OpenCaFolder_Click"
                                    IsEnabled="{Binding HasCaFolder}" Margin="8,0,0,6" />
                            <TextBlock Grid.Row="1" Text="Connected to" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionText}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Connect…" Click="Connect_Click" Margin="8,0,0,0"
                                    IsEnabled="{Binding CanEditConnection}" />
                        </Grid>

                        <DockPanel Margin="0,14,0,0" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource AccentButton}" Content="{Binding RefreshButtonText}" Click="Refresh_Click"
                                        IsEnabled="{Binding CanRefresh}" MinWidth="170"
                                        ToolTip="Rechecks the CA folder and reads fresh items in the CA Tracker browser window." />
                                <Button Content="Cancel" Click="CancelRefresh_Click" Margin="8,0,0,0"
                                        Visibility="{Binding IsRefreshing, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DataTimestampText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding FolderTimestampText}" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="{Binding RefreshMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding HasRefreshMessage, Converter={StaticResource Visible}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RefreshMessageIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding ProjectSubtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12"
                                   Visibility="{Binding HasProjectSubtitle, Converter={StaticResource Visible}}" />
                        <DockPanel Margin="0,8,0,0" Visibility="{Binding HasFolderWarning, Converter={StaticResource Visible}}">
                            <Button DockPanel.Dock="Right" Content="Create missing folders…" Click="CreateFolders_Click"
                                    Visibility="{Binding CanCreateTypeFolders, Converter={StaticResource Visible}}" />
                            <TextBlock Text="{Binding FolderWarning}" Foreground="{DynamicResource WarningBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Type, filters and sort -->
                <StackPanel Grid.Row="1" Margin="0,14,0,10">
                    <WrapPanel>
                        <RadioButton GroupName="Type" Style="{StaticResource SegmentButton}"
                                     Content="{Binding BothTabText}" Tag="all" IsChecked="True" Checked="Type_Checked"
                                     ToolTip="RFIs and Submittals in one list" />
                        <RadioButton GroupName="Type" Style="{StaticResource SegmentButton}"
                                     Content="{Binding RfiTabText}" Tag="rfi" Checked="Type_Checked" />
                        <RadioButton GroupName="Type" Style="{StaticResource SegmentButton}"
                                     Content="{Binding SubmittalTabText}" Tag="submittal" Checked="Type_Checked" Margin="0,0,18,0" />
                        <RadioButton GroupName="Filter" Style="{StaticResource SegmentButton}" Content="Open"
                                     Tag="open" IsChecked="True" Checked="Filter_Checked" ToolTip="Items that aren't closed" />
                        <RadioButton GroupName="Filter" Style="{StaticResource SegmentButton}" Content="All items"
                                     Tag="all" Checked="Filter_Checked" Margin="0,0,18,0" />
                        <TextBlock Text="Folders" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondary}" />
                        <RadioButton GroupName="Filter" Style="{StaticResource SegmentButton}" Content="Needs attention"
                                     Tag="attention" Checked="Filter_Checked" />
                        <RadioButton GroupName="Filter" Style="{StaticResource SegmentButton}" Content="Ready to return"
                                     Tag="ready" Checked="Filter_Checked" />
                        <RadioButton GroupName="Filter" Style="{StaticResource SegmentButton}" Content="No folder"
                                     Tag="nofolder" Checked="Filter_Checked" />
                        <RadioButton GroupName="Filter" Style="{StaticResource SegmentButton}" Content="In returned"
                                     Tag="returned" Checked="Filter_Checked" />
                    </WrapPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Text="Person" VerticalAlignment="Center" Margin="2,0,8,0" Foreground="{DynamicResource TextSecondary}" />
                        <Grid Margin="0,0,18,0">
                            <Button x:Name="PersonButton" Click="PersonButton_Click" MinWidth="180" HorizontalContentAlignment="Stretch"
                                    Padding="10,5" ToolTip="Who has the item now (in court / ball in court). Check one or more people.">
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                          Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" />
                                    <TextBlock Text="{Binding PersonFilterText}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                </DockPanel>
                            </Button>
                            <Popup x:Name="PersonPopup" PlacementTarget="{Binding ElementName=PersonButton}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True" Closed="PersonPopup_Closed">
                                <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,2,0,0" MinWidth="240">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Text="Who has it now" Style="{StaticResource SectionTitle}"
                                                       VerticalAlignment="Center" Margin="2,0,0,0" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Everyone"
                                                    Click="ClearPeople_Click" ToolTip="Clear the checks and show everyone" />
                                        </DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="12" Margin="2,0,0,6"
                                                   Text="No one has open items here yet. Refresh to read them."
                                                   Visibility="{Binding HasNoPersonChoices, Converter={StaticResource Visible}}" />
                                        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding PersonChoices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="2,3" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBlock Text="Due" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondary}" />
                        <ComboBox x:Name="DueBox" SelectionChanged="Due_Changed" MinWidth="150">
                            <ComboBoxItem Content="Any date" Tag="Any" IsSelected="True" />
                            <ComboBoxItem Content="Overdue" Tag="Overdue" />
                            <ComboBoxItem Content="Due today" Tag="DueToday" />
                            <ComboBoxItem Content="Due within…" Tag="DueWithin" />
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                    Visibility="{Binding IsDueWithin, Converter={StaticResource Visible}}">
                            <TextBox Text="{Binding DueWithinDays, UpdateSourceTrigger=PropertyChanged}" Width="48"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                            <TextBlock Text="days" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="Discipline" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="{DynamicResource TextSecondary}" />
                        <ComboBox x:Name="DisciplineBox" SelectionChanged="DisciplineBox_Changed" MinWidth="120">
                            <ComboBoxItem Content="All" Tag="" IsSelected="True" />
                            <ComboBoxItem Content="Electrical" Tag="Electrical" />
                            <ComboBoxItem Content="Fire" Tag="Fire" />
                            <ComboBoxItem Content="ICT" Tag="ICT" />
                            <ComboBoxItem Content="Mechanical" Tag="Mechanical" />
                            <ComboBoxItem Content="Plbg" Tag="Plbg" />
                            <ComboBoxItem Content="Security" Tag="Security" />
                            <ComboBoxItem Content="None" Tag="None" />
                        </ComboBox>

                        <TextBlock Text="Group by" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="{DynamicResource TextSecondary}" />
                        <ComboBox x:Name="GroupBox" SelectionChanged="Group_Changed" MinWidth="150"
                                  ToolTip="Headings for each project and/or for RFIs and Submittals. Sorting happens within each heading.">
                            <ComboBoxItem Content="Project, then type" Tag="project-type" IsSelected="True" />
                            <ComboBoxItem Content="Project" Tag="project" />
                            <ComboBoxItem Content="RFIs / Submittals" Tag="type" />
                            <ComboBoxItem Content="Nothing (one list)" Tag="none" />
                        </ComboBox>

                        <TextBlock Text="Sort by" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="{DynamicResource TextSecondary}" />
                        <ComboBox x:Name="SortBox" SelectionChanged="Sort_Changed" MinWidth="170"
                                  ToolTip="Or click any column heading to sort by it (click again to reverse)">
                            <ComboBoxItem Content="Number" Tag="number" IsSelected="True" />
                            <ComboBoxItem Content="Person" Tag="person" />
                            <ComboBoxItem Content="Days in court (longest)" Tag="court" />
                            <ComboBoxItem Content="Days till due (soonest)" Tag="due" />
                        </ComboBox>
                    </WrapPanel>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Rows}" IsReadOnly="True"
                              MouseDoubleClick="Grid_MouseDoubleClick" Sorting="ItemsGrid_Sorting"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              HorizontalScrollBarVisibility="Auto" SizeChanged="ItemsGrid_SizeChanged">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8,10,0,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" />
                                            <TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}" Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn x:Name="CheckColumn" Width="40" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox Click="TickAllShown_Click" HorizontalAlignment="Center"
                                              IsChecked="{Binding DataContext.AllShownChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                              ToolTip="Check or uncheck every item shown" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center"
                                                  ToolTip="Check to set its discipline or include its folder in a move" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="ProjectColumn" Header="Project" Binding="{Binding ProjectName}" Width="160"
                                                IsReadOnly="True" SortMemberPath="ProjectName" Visibility="Collapsed" />
                            <DataGridTextColumn x:Name="TypeColumn" Header="Type" Binding="{Binding TypeLabel}" Width="85"
                                                IsReadOnly="True" SortMemberPath="TypeLabel" />
                            <DataGridTextColumn x:Name="NumberColumn" Header="Number" Binding="{Binding Number}" Width="110" IsReadOnly="True" SortMemberPath="Number" />
                            <DataGridTextColumn x:Name="TitleColumn" Header="Title" Binding="{Binding Title}" Width="300" IsReadOnly="True" SortMemberPath="Title">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding Title}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="StatusColumn" Header="Status" Binding="{Binding ProviderStatus}" Width="95" IsReadOnly="True" SortMemberPath="ProviderStatus" />
                            <DataGridTextColumn x:Name="CourtColumn" Header="In court" Binding="{Binding HolderText}" Width="180" IsReadOnly="True"
                                                SortMemberPath="PersonSortKey">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding CourtText}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="DaysInCourtColumn" Header="Days in court" Binding="{Binding DaysInCourtText}" Width="95" IsReadOnly="True"
                                                SortMemberPath="DaysInCourt" />
                            <DataGridTextColumn x:Name="DueColumn" Header="Due" Binding="{Binding DueDateText}" Width="100" IsReadOnly="True"
                                                SortMemberPath="DaysTillDue" />
                            <DataGridTemplateColumn x:Name="DaysTillDueColumn" Header="Days till due" Width="120" SortMemberPath="DaysTillDue">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DaysTillDueText}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDueToday}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="FolderColumn" Header="Folder" Binding="{Binding FolderName}" Width="200" IsReadOnly="True" SortMemberPath="FolderName">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding LocationText}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn x:Name="DisciplineColumn" Header="Discipline" Width="140" SortMemberPath="DisciplineText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel ToolTip="{Binding DisciplineToolTip}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Set"
                                                    Click="SetRowDiscipline_Click" IsEnabled="{Binding CanSelect}"
                                                    ToolTip="Choose the discipline. For an item with no folder yet, its download goes into that discipline's folder." />
                                            <TextBlock Text="{Binding DisciplineText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DisciplineIsDetected}" Value="True">
                                                                <Setter Property="FontStyle" Value="Italic" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ResultColumn" Header="Folder result" Width="150" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusPill}" ToolTip="{Binding ToolTipText}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ActionsColumn" Width="Auto" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource LinkButton}" Content="Folder" Click="OpenRowFolder_Click"
                                                    IsEnabled="{Binding HasFolder}" ToolTip="Open this folder in Explorer" />
                                            <Button Style="{StaticResource LinkButton}" Content="Open item" Click="OpenRowLink_Click"
                                                    IsEnabled="{Binding HasItem}" ToolTip="Open this exact item (Helix items open in CA Tracker's browser)" />
                                            <Button Style="{StaticResource LinkButton}" Content="Download" Click="DownloadRow_Click"
                                                    IsEnabled="{Binding HasItem}"
                                                    ToolTip="Choose files to download into a &quot;number - name&quot; folder" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding HasEmptyText, Converter={StaticResource Visible}}" />

                    <!-- Actions: every button below opens a preview first. -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,10">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding SelectionText}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" Margin="4,0,16,0" />
                            <Button DockPanel.Dock="Left" Content="Check all ready to return" Click="SelectReady_Click" Margin="0,0,6,0" />
                            <Button DockPanel.Dock="Left" Content="Clear checks" Click="ClearTicks_Click" Margin="0,0,6,0" />
                            <Button DockPanel.Dock="Left" Content="Set discipline…" Click="SetTickedDiscipline_Click" Margin="0,0,6,0"
                                    ToolTip="Set the discipline of the checked items. Items with no folder yet download into that discipline's folder." />
                            <Button DockPanel.Dock="Left" Content="Download checked…" Click="DownloadChecked_Click"
                                    ToolTip="Download the checked items one after another: for each, choose the files and where they go" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Mark checked as returned…"
                                    Click="MarkReturned_Click" />
                            <Button DockPanel.Dock="Right" Content="Move checked back to active…" Click="MoveBack_Click" Margin="0,0,8,0" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="20,6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource SurfaceBackground}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Working…" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
