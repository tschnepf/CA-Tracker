<Window x:Class="SmcCaTracker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmcCaTracker.App.Views"
        Title="SMC CA Tracker"
        Width="1280" Height="800" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- An item row's right-click menu: every action on it. The row is the menu's DataContext. -->
        <ContextMenu x:Key="RowMenu">
            <MenuItem Header="Show details" Click="ShowRowDetails_Click" ToolTip="Show this item in the details pane beside the list" />
            <MenuItem Header="{Binding OpenOnlineText}" Click="OpenRowLink_Click" IsEnabled="{Binding HasItem}"
                      ToolTip="Helix items open in the panel on the right; Procore items open in your web browser" />
            <MenuItem Header="Download…" Click="DownloadRow_Click" IsEnabled="{Binding CanDownload}"
                      ToolTip="{Binding DownloadToolTip}" ToolTipService.ShowOnDisabled="True" />
            <Separator />
            <MenuItem Header="Open newest file" Click="OpenNewestFile_Click" IsEnabled="{Binding CanDownload}"
                      ToolTip="The copy in its folder when it's there, otherwise a copy from Helix (the CA folder isn't changed)" />
            <MenuItem Header="Open folder" Click="OpenRowFolder_Click" IsEnabled="{Binding HasFolder}" />
            <MenuItem Header="Verify folder…" Click="VerifyRow_Click" IsEnabled="{Binding CanDownload}"
                      ToolTip="Check that the item's folder has every file Helix has for it" />
            <Separator />
            <MenuItem Header="Set discipline…" Click="SetRowDiscipline_Click" IsEnabled="{Binding CanSelect}" />
            <MenuItem Header="Assign to…" Click="AssignRow_Click" IsEnabled="{Binding CanAssign}"
                      Visibility="{Binding ShowsAssignMenu, Converter={StaticResource Visible}}"
                      ToolTip="{Binding AssignMenuToolTip}" ToolTipService.ShowOnDisabled="True" />
        </ContextMenu>

        <!-- A row's ▾: what isn't on its own buttons (Open and Download are). Not shared, so each ▾ gets its own. -->
        <ContextMenu x:Key="RowMoreMenu" x:Shared="False">
            <MenuItem Header="Show details" Click="ShowRowDetails_Click" ToolTip="Show this item in the details pane beside the list" />
            <MenuItem Header="Open newest file" Click="OpenNewestFile_Click" IsEnabled="{Binding CanDownload}"
                      ToolTip="The copy in its folder when it's there, otherwise a copy from Helix (the CA folder isn't changed)" />
            <MenuItem Header="Open folder" Click="OpenRowFolder_Click" IsEnabled="{Binding HasFolder}" />
            <MenuItem Header="Verify folder…" Click="VerifyRow_Click" IsEnabled="{Binding CanDownload}"
                      ToolTip="Check that the item's folder has every file Helix has for it" />
            <Separator />
            <MenuItem Header="Set discipline…" Click="SetRowDiscipline_Click" IsEnabled="{Binding CanSelect}" />
            <MenuItem Header="Assign to…" Click="AssignRow_Click" IsEnabled="{Binding CanAssign}"
                      Visibility="{Binding ShowsAssignMenu, Converter={StaticResource Visible}}"
                      ToolTip="{Binding AssignMenuToolTip}" ToolTipService.ShowOnDisabled="True" />
        </ContextMenu>

        <!-- A view at the top of the project list (My work, Overdue): looks like a project row, highlighted
             while it is the one showing (Tag bound to whether it is). -->
        <Style x:Key="ViewButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A count in the project header that is also a filter (Tag bound to whether it is the one on). -->
        <Style x:Key="DueChip" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Padding" Value="11,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="13" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- "Details ▾" / "Hide details ▴" in the project header. -->
        <Style x:Key="DetailsToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Content" Value="Details ▾" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="4,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="Hide details ▴" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource NeutralSoftBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="ReadyToReturn">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Reopened">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Ambiguous">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NotInProvider">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Filed">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <!-- An open item with its folder where it belongs: nothing to point out. -->
                <DataTrigger Binding="{Binding Status}" Value="Open">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- The window's own title bar names the app, so there's no heading row: Sync all and Settings live in
         the project list. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sign-in needed: says so, with a button, instead of syncs that just fail. -->
        <Border Grid.Row="0" Padding="20,8" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Visibility="{Binding ShowSignInBanner, Converter={StaticResource Visible}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource LinkButton}" Click="DismissBanner_Click" Margin="8,0,0,0"
                        ToolTip="Hide this until a sign-in expires again" AutomationProperties.Name="Hide this message" />
                <Button DockPanel.Dock="Right" Content="Connect Workload Tracker" Click="BannerWorkload_Click" Margin="8,0,0,0"
                        Style="{StaticResource AccentButton}" Visibility="{Binding WorkloadTrackerNeedsConnect, Converter={StaticResource Visible}}" />
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Connections}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding SignInText}" Click="BannerSignIn_Click" Margin="8,0,0,0" Style="{StaticResource AccentButton}"
                                    Visibility="{Binding WantsSignIn, Converter={StaticResource Visible}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="⚠" Foreground="{DynamicResource WarningBrush}" />
                    <Run Text="{Binding SignInBannerText, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </DockPanel>
        </Border>

        <views:SettingsPage x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" />

        <Grid x:Name="ProjectsPage" Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ProjectsColumn" Width="290" MinWidth="220" MaxWidth="700" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition x:Name="ListColumn" Width="*" MinWidth="420" />
                <ColumnDefinition x:Name="PanelSplitterColumn" Width="0" />
                <ColumnDefinition x:Name="ItemPanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Drag to resize the project list (the width is remembered). -->
            <GridSplitter x:Name="ProjectsSplitter" Grid.Column="1" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"
                          DragCompleted="ProjectsSplitter_DragCompleted" ToolTip="Drag to resize the project list" />

            <!-- The item panel: an opened Helix item, beside the list (drag the bar to resize). -->
            <GridSplitter x:Name="PanelSplitter" Grid.Column="3" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" Visibility="Collapsed"
                          ToolTip="Drag to resize the item panel" />
            <views:ItemPanel x:Name="ItemPanel" Grid.Column="4" Visibility="Collapsed" />
            <!-- Or the selected item's details (View → Item details); Open in Helix switches to the Helix page. -->
            <views:DetailsPanel x:Name="DetailsPanel" Grid.Column="4" Visibility="Collapsed" />

            <!-- Projects -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <!-- PROJECTS, and how syncing stands ("● Synced 8:24 AM", "⟳ Syncing…", "⚠ Sign-in needed"). The pill
                         opens Sync all now (or Stop), one site, and Connections. Progress shows under the search box. -->
                    <DockPanel DockPanel.Dock="Top" Margin="6,0,4,8">
                        <Button x:Name="SyncMenuButton" DockPanel.Dock="Right" Click="SyncMenu_Click" Padding="9,3"
                                ToolTip="{Binding SyncPillToolTip}" AutomationProperties.Name="{Binding SyncPillText}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Width="11" TextAlignment="Center" RenderTransformOrigin="0.5,0.55">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="●" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SyncPillState}" Value="synced">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SyncPillState}" Value="failed">
                                                    <Setter Property="Text" Value="⚠" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SyncPillState}" Value="signin">
                                                    <Setter Property="Text" Value="⚠" />
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SyncPillState}" Value="syncing">
                                                    <Setter Property="Text" Value="⟳" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="SpinPill">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="SpinPill" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding SyncPillText}" VerticalAlignment="Center" FontSize="12" />
                                <Path VerticalAlignment="Center" Margin="7,1,0,0" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding SyncNowText}" Click="SyncAll_Click" />
                                    <MenuItem x:Name="SyncHelixMenu" Header="Sync Helix" Click="SyncHelix_Click" />
                                    <MenuItem x:Name="SyncProcoreMenu" Header="Sync Procore" Click="SyncProcore_Click" />
                                    <Separator />
                                    <MenuItem Header="Connections…" Click="OpenConnections_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBlock Text="PROJECTS" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- Find a project (Ctrl+F): by name or hosting company. -->
                    <Grid DockPanel.Dock="Top" Margin="4,0,4,8">
                        <TextBox x:Name="ProjectSearchBox" Text="{Binding ProjectSearch, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                 AutomationProperties.Name="Find a project" KeyDown="ProjectSearch_KeyDown" />
                        <TextBlock Text="Find a project (Ctrl+F)" Foreground="{DynamicResource TextMuted}" Margin="11,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Visibility="{Binding IsProjectSearchEmpty, Converter={StaticResource Visible}}" />
                    </Grid>
                    <!-- What is syncing now, then how the sync ended (hides after a little while). -->
                    <Border DockPanel.Dock="Top" Margin="4,0,4,8" Padding="8,6" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"
                            Visibility="{Binding IsSyncProgressVisible, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SyncProgressText}" FontSize="11.5" TextWrapping="Wrap" />
                            <ProgressBar Value="{Binding SyncProgressValue, Mode=OneWay}" Maximum="100" Height="3" Margin="0,5,0,0"
                                         BorderThickness="0" Background="{DynamicResource LineBrush}" Foreground="{DynamicResource AccentBrush}"
                                         Visibility="{Binding IsSyncProgressRunning, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Border>
                    <!-- Views across every linked project: your open items, and everything overdue. -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                        <TextBlock Text="VIEWS" Style="{StaticResource SectionTitle}" Margin="6,2,0,4" />
                        <Button Style="{StaticResource ViewButton}" Click="ShowMyWork_Click" Tag="{Binding IsMyWorkActive}"
                                IsEnabled="{Binding CanShowMyWork}" ToolTip="{Binding MyWorkToolTip}" ToolTipService.ShowOnDisabled="True"
                                AutomationProperties.Name="My work">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="9" Padding="7,1" Margin="0,0,4,0"
                                            Visibility="{Binding HasMyWorkOverdue, Converter={StaticResource Visible}}">
                                        <TextBlock Text="{Binding MyWorkOverdueText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="7,1"
                                            Visibility="{Binding HasMyWorkOpen, Converter={StaticResource Visible}}">
                                        <TextBlock Text="{Binding MyWorkOpenText}" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="My work" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource ViewButton}" Click="ShowAllOverdue_Click" Tag="{Binding IsAllOverdueActive}"
                                ToolTip="Overdue items in every linked project, whoever has them" AutomationProperties.Name="Overdue, all projects">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource DangerSoftBrush}" CornerRadius="9" Padding="7,1" VerticalAlignment="Center"
                                        Visibility="{Binding HasAllOverdue, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding AllOverdueText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                                </Border>
                                <TextBlock Text="Overdue, all projects" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>

                        <!-- Watchlists: the people you follow on each project. Click one to show it; right-click to edit or delete. -->
                        <DockPanel Margin="6,10,2,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="+ New" Click="NewWatchlist_Click" Padding="4,0"
                                    ToolTip="Make a watchlist: the people you follow on each project" AutomationProperties.Name="New watchlist" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Board" Click="TeamBoard_Click" Padding="4,0"
                                    Margin="0,0,4,0" Visibility="{Binding HasWatchlists, Converter={StaticResource Visible}}"
                                    ToolTip="Team board: each watchlist's people by project, with their overdue and open counts" AutomationProperties.Name="Team board" />
                            <TextBlock Text="WATCHLISTS" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="6,0,4,4"
                                   Visibility="{Binding HasNoWatchlists, Converter={StaticResource Visible}}"
                                   Text="Follow chosen people on chosen projects: + New." />
                        <ItemsControl ItemsSource="{Binding WatchlistItems}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ViewButton}" Click="ShowWatchlist_Click" Tag="{Binding IsActive}"
                                            AutomationProperties.Name="{Binding Name}"
                                            ToolTip="The open items its people hold on the projects they're watched on. Right-click to edit or delete it.">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Team board…" Click="WatchlistBoard_Click" />
                                                <MenuItem Header="Edit…" Click="EditWatchlist_Click" />
                                                <MenuItem Header="Delete…" Click="DeleteWatchlist_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="9" Padding="7,1" Margin="0,0,4,0"
                                                        Visibility="{Binding HasOverdue, Converter={StaticResource Visible}}">
                                                    <TextBlock Text="{Binding OverdueText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                                                </Border>
                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="7,1"
                                                        Visibility="{Binding HasOpen, Converter={StaticResource Visible}}">
                                                    <TextBlock Text="{Binding OpenText}" FontSize="11.5" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- New project, and Settings (which opens in place of the projects, with its own way back). -->
                    <Grid DockPanel.Dock="Bottom" Margin="4,8,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="_New project…" Click="NewProject_Click" ToolTip="Start tracking a CA folder" />
                        <Button x:Name="SettingsButton" Grid.Column="1" Content="Se_ttings" Click="Settings_Click" Margin="6,0,0,0" />
                    </Grid>
                    <Button DockPanel.Dock="Bottom" Content="{Binding UpdateText}" Click="InstallUpdate_Click" Margin="4,8,4,0"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource Visible}}"
                            ToolTip="{Binding UpdateNotes}" />
                    <CheckBox DockPanel.Dock="Bottom" Content="{Binding ShowArchivedText}" IsChecked="{Binding ShowArchived}"
                              Margin="6,8,4,0" Visibility="{Binding HasArchived, Converter={StaticResource Visible}}"
                              ToolTip="Archived projects are hidden and not synced, for you only. Check to show them (dimmed) and unarchive them." />
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11.5" Margin="6,8,4,0"
                               Text="Ctrl-click to see several projects together." />
                    <Grid>
                        <ListBox x:Name="ProjectList" ItemsSource="{Binding Projects}" SelectionMode="Extended"
                                 SelectionChanged="ProjectList_SelectionChanged" AutomationProperties.Name="Projects"
                                 PreviewMouseRightButtonDown="ProjectList_PreviewMouseRightButtonDown"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ContextMenuOpening="ProjectList_ContextMenuOpening">
                            <!-- Procore projects can be left out of syncing (they stay in the list). -->
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="FavoriteProjectMenu" Header="Add to favorites" Click="FavoriteProject_Click" />
                                    <MenuItem x:Name="UnfavoriteProjectMenu" Header="Remove from favorites" Click="UnfavoriteProject_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ArchiveProjectMenu" Header="Archive" Click="ArchiveProject_Click"
                                              ToolTip="Hide it from your list and stop syncing it. For you only: nothing changes in Helix, Procore or on the company server." />
                                    <MenuItem x:Name="UnarchiveProjectMenu" Header="Unarchive" Click="UnarchiveProject_Click" />
                                    <Separator x:Name="SyncMenuSeparator" />
                                    <MenuItem x:Name="SyncProjectMenu" Header="Sync this project" Click="SyncProject_Click" />
                                    <MenuItem x:Name="SkipProjectMenu" Header="Don't sync this project" Click="SkipProject_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <!-- Sections: projects with a CA folder, then Helix/Procore projects without one. -->
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="6,10,0,4">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="0" />
                                                <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" Style="{StaticResource SectionTitle}" Margin="0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding ListToolTip}">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSyncSkipped}" Value="True">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <DockPanel>
                                                <!-- Sync status: spinning while syncing, dot while waiting, check when done, ⚠ if it failed. -->
                                                <TextBlock DockPanel.Dock="Left" Margin="0,0,5,0" Width="12" TextAlignment="Center"
                                                           RenderTransformOrigin="0.5,0.55" AutomationProperties.Name="{Binding SyncState}">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </TextBlock.RenderTransform>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SyncState}" Value="syncing">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Text" Value="⟳" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="SpinSync">
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                                                                 From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <StopStoryboard BeginStoryboardName="SpinSync" />
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SyncState}" Value="queued">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Text" Value="•" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SyncState}" Value="done">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Text" Value="✓" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SyncState}" Value="failed">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Text" Value="⚠" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock DockPanel.Dock="Left" Text="★" Margin="0,0,5,0" Foreground="{DynamicResource AccentBrush}"
                                                           AutomationProperties.Name="Favorite"
                                                           Visibility="{Binding IsFavorite, Converter={StaticResource Visible}}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- "2 overdue" (only when some are), then how many items match the list's filters ("7 open"). -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="9" Padding="7,1" Margin="0,0,4,0"
                                                    Visibility="{Binding HasOverdue, Converter={StaticResource Visible}}"
                                                    ToolTip="Overdue, among the items that match the filters">
                                                <TextBlock Text="{Binding OverdueText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                                            </Border>
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="7,1"
                                                    Visibility="{Binding HasBadge, Converter={StaticResource Visible}}" ToolTip="{Binding BadgeToolTip}">
                                                <TextBlock Text="{Binding BadgeText}" FontSize="11.5" FontWeight="SemiBold"
                                                           AutomationProperties.Name="{Binding BadgeToolTip}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{StaticResource Muted}" Margin="8" VerticalAlignment="Top"
                                   Visibility="{Binding HasNoProjects, Converter={StaticResource Visible}}"
                                   Text="No projects yet. Sign in to Helix or Procore (Settings → Connections) to list your projects, or select New project… to start from a CA folder." />
                        <TextBlock Style="{StaticResource Muted}" Margin="8" VerticalAlignment="Top"
                                   Visibility="{Binding HasNoSearchResults, Converter={StaticResource Visible}}"
                                   Text="No projects match. Clear the search box to see them all." />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Selected project -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The selected project, kept compact so the item list gets the room: its name and actions, counts by
                     when items are due (each one a quick Due filter), when it was synced, and its CA folder and link
                     under Details. Problems with the folder setup gather in one chip that opens them. -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Items back with you whose folders are in Returned: bring them back with a new R folder. -->
                                <Button Content="{Binding ReopenedText}" Click="Reopened_Click" Margin="0,0,8,0" Padding="10,5"
                                        Background="{DynamicResource WarningSoftBrush}" Foreground="{DynamicResource WarningBrush}"
                                        BorderBrush="{DynamicResource WarningSoftBrush}"
                                        Visibility="{Binding HasReopened, Converter={StaticResource Visible}}"
                                        ToolTip="These items are back with your company, but their folders are in Returned. This moves each folder back and makes a new R folder in it for the new round (R0 for what it holds and R1 the first time; the next number after that). A preview shows every step first." />
                                <Button Content="{Binding FilingButtonText}" Click="Filing_Click" Margin="0,0,8,0" IsEnabled="{Binding HasProject}"
                                        ToolTip="{Binding FilingButtonToolTip}" />
                                <Grid Margin="0,0,8,0" Visibility="{Binding HasSetupChip, Converter={StaticResource Visible}}">
                                    <Button x:Name="SetupButton" Content="{Binding SetupIssuesText}" Click="Setup_Click" Padding="10,5"
                                            Background="{DynamicResource WarningSoftBrush}" Foreground="{DynamicResource WarningBrush}"
                                            BorderBrush="{DynamicResource WarningSoftBrush}" ToolTip="{Binding FolderWarning}" />
                                    <Popup x:Name="SetupPopup" PlacementTarget="{Binding ElementName=SetupButton}" Placement="Bottom"
                                           StaysOpen="False" AllowsTransparency="True" Closed="SetupPopup_Closed">
                                        <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource LineBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,2,0,0" MaxWidth="440">
                                            <StackPanel>
                                                <TextBlock Text="SETUP" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="{Binding FolderWarning}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,10,0,0">
                                                    <Button Content="{Binding IncludeUnlabeledText}" Click="IncludeUnlabeled_Click" Margin="0,0,8,4"
                                                            Visibility="{Binding CanIncludeUnlabeled, Converter={StaticResource Visible}}"
                                                            ToolTip="Also count folders and items that say neither BB nor TFO as this part (Edit project → Base Build / Tenant Fit Out)" />
                                                    <Button Content="Create missing folders…" Click="CreateFolders_Click" Margin="0,0,8,4"
                                                            Visibility="{Binding CanCreateTypeFolders, Converter={StaticResource Visible}}" />
                                                    <Button Content="Edit project…" Click="EditProject_Click" Margin="0,0,8,4" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Button Content="{Binding RefreshButtonText}" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}"
                                        ToolTip="Reads every RFI and Submittal again and rescans the CA folder (F5). CA Tracker also does this by itself in the background." />
                                <Button Content="Cancel" Click="CancelRefresh_Click" Margin="8,0,0,0"
                                        ToolTip="Stops this sync (a background sync finishes by itself)"
                                        Visibility="{Binding CanCancelRefresh, Converter={StaticResource Visible}}" />
                                <Button Content="{Binding EditButtonText}" Click="EditProject_Click" Margin="8,0,0,0"
                                        Visibility="{Binding CanEditProject, Converter={StaticResource Visible}}" />
                                <Button x:Name="ProjectMenuButton" Content="⋯" Click="ProjectMenu_Click" Margin="4,0,0,0" Padding="10,6"
                                        IsEnabled="{Binding HasProject}" AutomationProperties.Name="More project actions"
                                        ToolTip="Favorite, archive, or turn syncing on or off (also on right-click in the project list)" />
                            </StackPanel>
                            <TextBlock Text="{Binding ProjectTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" ToolTip="{Binding ProjectTitle}" />
                        </DockPanel>

                        <!-- How many are overdue, due today, due soon, and in all (as the list is filtered). Each is the
                             Due filter: click one to show just those, click it again for all. -->
                        <WrapPanel Margin="0,8,0,0" Visibility="{Binding ShowDueChips, Converter={StaticResource Visible}}">
                            <Button Style="{StaticResource DueChip}" Content="{Binding AllChipText}" Tag="{Binding IsDueAnyFilter}"
                                    CommandParameter="Any" Click="DueChip_Click" ToolTip="Show them all, whenever they're due" />
                            <Button Style="{StaticResource DueChip}" Content="{Binding OverdueChipText}" Tag="{Binding IsDueOverdueFilter}"
                                    CommandParameter="Overdue" Click="DueChip_Click" Foreground="{DynamicResource DangerBrush}"
                                    Visibility="{Binding HasOverdueChip, Converter={StaticResource Visible}}" ToolTip="Show only the overdue ones (click again for all)" />
                            <Button Style="{StaticResource DueChip}" Content="{Binding DueTodayChipText}" Tag="{Binding IsDueTodayFilter}"
                                    CommandParameter="DueToday" Click="DueChip_Click" Foreground="{DynamicResource WarningBrush}"
                                    Visibility="{Binding HasDueTodayChip, Converter={StaticResource Visible}}" ToolTip="Show only the ones due today (click again for all)" />
                            <Button Style="{StaticResource DueChip}" Content="{Binding DueSoonChipText}" Tag="{Binding IsDueSoonFilter}"
                                    CommandParameter="DueWithin" Click="DueChip_Click"
                                    Visibility="{Binding HasDueSoonChip, Converter={StaticResource Visible}}"
                                    ToolTip="Show only the ones due from today on, within the days set beside Due (click again for all)" />
                        </WrapPanel>

                        <!-- When the items and the CA folder were last read (a failed sync says why, in full), and Details. -->
                        <DockPanel Margin="0,6,0,0" Visibility="{Binding CanShowProjectDetails, Converter={StaticResource Visible}}">
                            <ToggleButton x:Name="DetailsToggle" DockPanel.Dock="Right" Style="{StaticResource DetailsToggle}" Margin="8,0,0,0"
                                          VerticalAlignment="Top" ToolTip="The CA folder, and the Helix or Procore project it is linked to" />
                            <TextBlock Text="{Binding TimestampText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastSyncFailed}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                        <Border Visibility="{Binding CanShowProjectDetails, Converter={StaticResource Visible}}">
                            <Grid Margin="0,6,0,0" IsEnabled="{Binding HasProject}"
                                  Visibility="{Binding IsChecked, ElementName=DetailsToggle, Converter={StaticResource Visible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="CA folder" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CaFolderText}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CaFolderText}" />
                                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource LinkButton}" Content="Open in Explorer"
                                        Click="OpenCaFolder_Click" IsEnabled="{Binding HasCaFolder}" Margin="8,0,0,0" />
                                <TextBlock Grid.Row="1" Text="Linked to" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionText}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ConnectionText}" />
                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource LinkButton}" Content="_Link…" Click="Connect_Click"
                                        Margin="8,0,0,0" IsEnabled="{Binding CanEditConnection}"
                                        ToolTip="Choose the Helix or Procore project this CA folder belongs to" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding RefreshMessage}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding HasRefreshMessage, Converter={StaticResource Visible}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RefreshMessageIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding ProjectSubtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12"
                                   Visibility="{Binding HasProjectSubtitle, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Border>

                <!-- Find an item, the type, then the filters, each saying what it is set to ("Open items", "Any due date"),
                     and View (grouping, sort and columns). On one line in a wide window; they wrap together otherwise. -->
                <WrapPanel Grid.Row="1" Margin="0,10,0,4">
                    <!-- Find an item (Ctrl+E): as you type, only items whose number, title or folder name contains it. -->
                    <Grid Width="250" Margin="0,0,10,6">
                        <TextBox x:Name="ItemSearchBox" Text="{Binding ItemSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 Padding="8,5,28,5" VerticalContentAlignment="Center" AutomationProperties.Name="Find an item"
                                 PreviewKeyDown="ItemSearch_PreviewKeyDown"
                                 ToolTip="Shows only the items whose number, title or folder name contains what you type. Esc clears it; Down goes to the list." />
                        <TextBlock Text="Find by number or title (Ctrl+E)" Foreground="{DynamicResource TextMuted}" Margin="11,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=ItemSearchBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="✕" Click="ClearItemSearch_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                                Padding="6,1" FontSize="11" Foreground="{DynamicResource TextSecondary}" Focusable="False"
                                AutomationProperties.Name="Clear the search" ToolTip="Clear the search (Esc)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=ItemSearchBox}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                        <RadioButton x:Name="BothTypeButton" GroupName="Type" Style="{StaticResource SegmentButton}" Padding="9,5"
                                     Content="{Binding BothTabText}" Tag="all" IsChecked="True" Checked="Type_Checked"
                                     ToolTip="RFIs and Submittals in one list" />
                        <RadioButton GroupName="Type" Style="{StaticResource SegmentButton}" Padding="9,5"
                                     Content="{Binding RfiTabText}" Tag="rfi" Checked="Type_Checked" />
                        <RadioButton GroupName="Type" Style="{StaticResource SegmentButton}" Padding="9,5"
                                     Content="{Binding SubmittalTabText}" Tag="submittal" Checked="Type_Checked" Margin="0" />
                    </StackPanel>

                    <ComboBox x:Name="ShowBox" SelectionChanged="Show_Changed" MinWidth="100" Margin="0,0,6,6" AutomationProperties.Name="Show"
                              ToolTip="Open items, or all of them (folder housekeeping is under Filing)"
                              Visibility="{Binding IsNotFiling, Converter={StaticResource Visible}}">
                        <ComboBoxItem Content="Open items" Tag="open" IsSelected="True" />
                        <ComboBoxItem Content="All items" Tag="all" />
                    </ComboBox>

                    <!-- Filing's tabs, in place of Show, In court and Due (which don't apply to folder housekeeping). -->
                    <WrapPanel Visibility="{Binding IsFiling, Converter={StaticResource Visible}}">
                        <Button Style="{StaticResource DueChip}" Content="{Binding FilingAttentionText}" Tag="{Binding IsFilingAttention}" Margin="0,0,6,6"
                                CommandParameter="attention" Click="FilingTab_Click" ToolTip="Every folder below that needs a look" />
                        <Button Style="{StaticResource DueChip}" Content="{Binding FilingReadyText}" Tag="{Binding IsFilingReady}" Margin="0,0,6,6"
                                CommandParameter="ready" Click="FilingTab_Click" ToolTip="Returned by the rule, but the folder is still in the active folder: Move to Returned" />
                        <Button Style="{StaticResource DueChip}" Content="{Binding FilingReopenedText}" Tag="{Binding IsFilingReopened}" Margin="0,0,6,6"
                                CommandParameter="reopened" Click="FilingTab_Click" ToolTip="The folder is in Returned, but the item is back with your company: Move back to active" />
                        <Button Style="{StaticResource DueChip}" Content="{Binding FilingDuplicatesText}" Tag="{Binding IsFilingDuplicates}" Margin="0,0,6,6"
                                CommandParameter="duplicates" Click="FilingTab_Click" ToolTip="More than one folder for an item, or a folder that matches several items" />
                        <Button Style="{StaticResource DueChip}" Content="{Binding FilingNoItemText}" Tag="{Binding IsFilingNoItem}" Margin="0,0,6,6"
                                CommandParameter="noitem" Click="FilingTab_Click" ToolTip="Folders with no Helix or Procore item" />
                        <Button Style="{StaticResource DueChip}" Content="{Binding FilingNoFolderText}" Tag="{Binding IsFilingNoFolder}" Margin="0,0,6,6"
                                CommandParameter="nofolder" Click="FilingTab_Click" ToolTip="Open items with no folder yet (Download makes one)" />
                        <Button Style="{StaticResource DueChip}" Content="{Binding FilingReturnedText}" Tag="{Binding IsFilingReturned}" Margin="0,0,6,6"
                                CommandParameter="returned" Click="FilingTab_Click" ToolTip="Every folder in the Returned folder" />
                    </WrapPanel>

                    <Grid Margin="0,0,6,6" Visibility="{Binding IsNotFiling, Converter={StaticResource Visible}}">
                        <Button x:Name="PersonButton" Click="PersonButton_Click" HorizontalContentAlignment="Stretch"
                                Padding="10,5" Background="{DynamicResource InputBackground}" AutomationProperties.Name="Ball in court"
                                ToolTip="Who has the item now. Check one or more people.">
                            <DockPanel>
                                <Path DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,1,0"
                                      Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" />
                                <TextBlock TextTrimming="CharacterEllipsis" MaxWidth="220">
                                    <Run Text="In court:" Foreground="{DynamicResource TextSecondary}" />
                                    <Run Text="{Binding PersonFilterText, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                        </Button>
                        <Popup x:Name="PersonPopup" PlacementTarget="{Binding ElementName=PersonButton}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" Closed="PersonPopup_Closed" Opened="PersonPopup_Opened"
                               KeyDown="PersonPopup_KeyDown">
                            <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,2,0,0" MinWidth="240">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="BALL IN COURT" Style="{StaticResource SectionTitle}"
                                                   VerticalAlignment="Center" Margin="2,0,0,0" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Everyone"
                                                Click="ClearPeople_Click" ToolTip="Clear the checks and show everyone" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Just you"
                                                Click="ShowOnlyYou_Click" ToolTip="Check only yourself (the name you're signed in to Helix or Procore as)"
                                                Visibility="{Binding CanShowOnlyYou, Converter={StaticResource Visible}}" />
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="12" Margin="2,0,0,6"
                                               Text="No one has open items here yet. Sync to read them."
                                               Visibility="{Binding HasNoPersonChoices, Converter={StaticResource Visible}}" />
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="12" Margin="2,0,0,6" MaxWidth="300"
                                               Text="A watchlist is showing. Checking people here shows them instead; Everyone clears it."
                                               Visibility="{Binding HasActiveWatchlist, Converter={StaticResource Visible}}" />
                                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="PersonChoiceList" ItemsSource="{Binding PersonChoices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="2,3">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAbsent}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.6" />
                                                                        <Setter Property="ToolTip" Value="Holds nothing in the projects shown; still checked, so the list stays filtered" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,6,6" Visibility="{Binding IsNotFiling, Converter={StaticResource Visible}}">
                        <ComboBox x:Name="DueBox" SelectionChanged="Due_Changed" MinWidth="100" AutomationProperties.Name="Due"
                                  ToolTip="When the items are due (the counts under the project's name set this too)">
                            <ComboBoxItem Content="Any due date" Tag="Any" IsSelected="True" />
                            <ComboBoxItem Content="Overdue" Tag="Overdue" />
                            <ComboBoxItem Content="Due today" Tag="DueToday" />
                            <ComboBoxItem Content="Due within…" Tag="DueWithin" />
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                    Visibility="{Binding IsDueWithin, Converter={StaticResource Visible}}">
                            <TextBox Text="{Binding DueWithinDays, UpdateSourceTrigger=PropertyChanged}" Width="48"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" AutomationProperties.Name="Days" />
                            <TextBlock Text="days" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <ComboBox x:Name="DisciplineBox" SelectionChanged="DisciplineBox_Changed" MinWidth="100" Margin="0,0,6,6"
                              AutomationProperties.Name="Discipline" ToolTip="Only the items of one discipline">
                        <ComboBoxItem Content="All disciplines" Tag="" IsSelected="True" />
                    </ComboBox>

                    <Button x:Name="ViewButton" Click="ViewButton_Click" Padding="10,5" Margin="0,0,0,6"
                            AutomationProperties.Name="View: grouping, sort and columns" ToolTip="Group, sort, and choose the columns">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="View" />
                            <Path VerticalAlignment="Center" Margin="8,1,0,0" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" />
                        </StackPanel>
                    </Button>

                    <!-- The grouping and sort the View menu sets (they keep the choice and its effects; not shown). -->
                    <StackPanel Visibility="Collapsed">
                        <ComboBox x:Name="GroupBox" SelectionChanged="Group_Changed" MinWidth="140" AutomationProperties.Name="Group by"
                                  ToolTip="Headings for when items are due, for each project, or for RFIs and Submittals. Sorting happens within each heading.">
                            <ComboBoxItem Content="When it's due" Tag="urgency" IsSelected="True" />
                            <ComboBoxItem Content="Project, then type" Tag="project-type" />
                            <ComboBoxItem Content="Project" Tag="project" />
                            <ComboBoxItem Content="RFIs / Submittals" Tag="type" />
                            <ComboBoxItem Content="Nothing (one list)" Tag="none" />
                        </ComboBox>
                        <ComboBox x:Name="SortBox" SelectionChanged="Sort_Changed" MinWidth="150" AutomationProperties.Name="Sort by"
                                  ToolTip="Or click any column heading to sort by it (click again to reverse)">
                            <ComboBoxItem Content="Number" Tag="number" IsSelected="True" />
                            <ComboBoxItem Content="Ball in court (A–Z)" Tag="person" />
                            <ComboBoxItem Content="Days in court (longest)" Tag="court" />
                            <ComboBoxItem Content="Due (soonest)" Tag="due" />
                            <!-- Shown after a column heading is clicked: "Title ↑". -->
                            <ComboBoxItem x:Name="SortByColumnItem" Content="By column heading" Tag="column" Visibility="Collapsed" />
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Rows}" IsReadOnly="True"
                              MouseDoubleClick="Grid_MouseDoubleClick" PreviewKeyDown="ItemsGrid_PreviewKeyDown" Sorting="ItemsGrid_Sorting"
                              PreviewMouseLeftButtonDown="ItemsGrid_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="ItemsGrid_PreviewMouseRightButtonDown"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              HorizontalScrollBarVisibility="Auto" SizeChanged="ItemsGrid_SizeChanged" FrozenColumnCount="2"
                              AutomationProperties.Name="Items">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                                <!-- A stripe down the left edge: red when overdue, amber when due today. -->
                                <Setter Property="BorderThickness" Value="3,0,0,0" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDueToday}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8,10,0,4">
                                            <!-- "Overdue" and "Due today" headings in their colours. -->
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Name}" Value="Overdue">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Due today">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Assigned to me">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}" Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn x:Name="CheckColumn" Width="40" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox Click="TickAllShown_Click" HorizontalAlignment="Center" AutomationProperties.Name="Check every item shown"
                                              IsChecked="{Binding DataContext.AllShownChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                              ToolTip="Check or uncheck every item shown" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center" Click="RowCheck_Click"
                                                  AutomationProperties.Name="{Binding Number, StringFormat=Check {0}}"
                                                  ToolTip="Check to download it, set its discipline, or include its folder in a move. Shift-click another box to check every row between; Space checks the selected rows." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Open Online (the item in the built-in Helix page, or a Procore item in your web browser),
                                 Download, and ▾ for the rest (everything is also on right-click). Beside the box so they
                                 never scroll out of sight. -->
                            <DataGridTemplateColumn x:Name="ActionsColumn" Width="232" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Open Online" Click="OpenRow_Click" IsEnabled="{Binding HasItem}" Padding="10,2" FontSize="12.5"
                                                    ToolTip="{Binding OpenToolTip}" ToolTipService.ShowOnDisabled="True"
                                                    AutomationProperties.Name="{Binding Number, StringFormat=Open {0} online}" />
                                            <Button Content="Download" Click="DownloadRow_Click" IsEnabled="{Binding CanDownload}" Padding="9,2"
                                                    FontSize="12.5" Margin="4,0,0,0"
                                                    ToolTip="{Binding DownloadToolTip}" ToolTipService.ShowOnDisabled="True"
                                                    AutomationProperties.Name="{Binding Number, StringFormat=Download {0}}" />
                                            <Button Content="▾" Click="RowMenu_Click" Padding="7,2" FontSize="12.5" Margin="4,0,0,0"
                                                    ToolTip="Open its newest file or its folder, verify its folder, or set its discipline"
                                                    AutomationProperties.Name="{Binding Number, StringFormat=More for {0}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="ProjectColumn" Header="Project" Binding="{Binding ProjectName}" Width="160"
                                                IsReadOnly="True" SortMemberPath="ProjectName" Visibility="Collapsed" />
                            <DataGridTextColumn x:Name="TypeColumn" Header="Type" Binding="{Binding TypeSingular}" Width="85"
                                                IsReadOnly="True" SortMemberPath="TypeLabel" />
                            <DataGridTextColumn x:Name="NumberColumn" Header="Number" Binding="{Binding Number}" Width="110" IsReadOnly="True" SortMemberPath="Number" />
                            <!-- The date and how far off it is: "Sep 7 · 26 days overdue". Right after the number, so it
                                 stays in view in a narrow window. (Named for the column it replaced, so a choice to hide
                                 it is kept.) -->
                            <DataGridTemplateColumn x:Name="DaysTillDueColumn" Header="Due" Width="160" SortMemberPath="DaysTillDue">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DueText}" VerticalAlignment="Center" ToolTip="{Binding DueToolTip}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDueToday}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- The item's title, or (grey italic) the folder's name when there's no item. -->
                            <DataGridTextColumn x:Name="TitleColumn" Header="Title" Binding="{Binding TitleText}" Width="300" IsReadOnly="True" SortMemberPath="Title">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding TitleToolTip}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItem}" Value="False">
                                                <Setter Property="FontStyle" Value="Italic" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="StatusColumn" Header="Item status" Binding="{Binding ProviderStatus}" Width="95" IsReadOnly="True" SortMemberPath="ProviderStatus" />
                            <DataGridTextColumn x:Name="CourtColumn" Header="Ball in court" Binding="{Binding HolderText}" Width="180" IsReadOnly="True"
                                                SortMemberPath="PersonSortKey">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding CourtText}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- Shown while a shown project is bound to a Workload Tracker project. -->
                            <DataGridTextColumn x:Name="AssignedColumn" Header="Assigned" Binding="{Binding AssignedText}" Width="150" IsReadOnly="True"
                                                SortMemberPath="AssignedSortKey">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding AssignedToolTip}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="DaysInCourtColumn" Header="Days in court" Binding="{Binding DaysInCourtText}" Width="95" IsReadOnly="True"
                                                SortMemberPath="DaysInCourt" />
                            <DataGridTextColumn x:Name="FolderColumn" Header="Folder" Binding="{Binding FolderName}" Width="200" IsReadOnly="True" SortMemberPath="FolderName">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding FolderToolTip}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn x:Name="DisciplineColumn" Header="Discipline" Width="140" SortMemberPath="DisciplineText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel ToolTip="{Binding DisciplineToolTip}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Set"
                                                    Click="SetRowDiscipline_Click" IsEnabled="{Binding CanSelect}"
                                                    ToolTip="Choose the discipline. On one of several checked (or selected) items, it sets them all. For an item with no folder yet, its download goes into that discipline's folder." />
                                            <TextBlock Text="{Binding DisciplineText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <!-- Detected (not set by hand): grey italic, "(auto)" in the text. -->
                                                            <DataTrigger Binding="{Binding DisciplineIsDetected}" Value="True">
                                                                <Setter Property="FontStyle" Value="Italic" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ResultColumn" Header="Folder status" Width="150" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusPill}" ToolTip="{Binding ToolTipText}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Nothing to show: say why, and offer the way out when filters hide everything. -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasEmptyText, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" FontSize="14" TextAlignment="Center" MaxWidth="520" />
                        <Button Content="Clear filters" Click="ClearFilters_Click" HorizontalAlignment="Center" Margin="0,10,0,0"
                                Visibility="{Binding CanClearFilters, Converter={StaticResource Visible}}" />
                        <!-- Searching: look past the filters, or stop searching. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                                    Visibility="{Binding HasItemSearch, Converter={StaticResource Visible}}">
                            <Button Content="Search all items" Click="SearchAllItems_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                                    ToolTip="Every item of either type, open or closed, whoever has it, any due date and discipline"
                                    Visibility="{Binding HasHiddenSearchMatches, Converter={StaticResource Visible}}" />
                            <Button Content="Clear search" Click="ClearItemSearch_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Actions on the checked items, shown while something is checked (or ready to return). Only
                         the actions that apply appear; Download is the main one. Moves open a preview first; buttons
                         say how many they act on. -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,8"
                            Visibility="{Binding ShowActionBar, Converter={StaticResource Visible}}">
                        <Border.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Padding" Value="10,5" />
                            </Style>
                        </Border.Resources>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" Margin="4,0,14,0"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <Button Content="{Binding CheckReadyText}" Click="SelectReady_Click" Margin="0,2,6,2"
                                        Visibility="{Binding HasReadyShown, Converter={StaticResource Visible}}"
                                        ToolTip="Checks the shown folders that are ready to move to Returned" />
                                <Button Content="Clear checks" Click="ClearTicks_Click" Margin="0,2,6,2"
                                        Visibility="{Binding HasChecks, Converter={StaticResource Visible}}" />
                                <Button Content="{Binding AssignCheckedText}" Click="AssignChecked_Click" Margin="0,2,6,2"
                                        Visibility="{Binding CanAssignChecked, Converter={StaticResource Visible}}"
                                        ToolTip="Choose who on the Workload Tracker project's team works on the checked items" />
                                <Button Content="{Binding SetDisciplineText}" Click="SetTickedDiscipline_Click" Margin="0,2,6,2"
                                        Visibility="{Binding CanSetDiscipline, Converter={StaticResource Visible}}"
                                        ToolTip="Set the discipline of the checked items. Items with no folder yet download into that discipline's folder." />
                                <Button Content="{Binding VerifyCheckedText}" Click="VerifyChecked_Click" Margin="0,2,6,2"
                                        Visibility="{Binding CanDownloadChecked, Converter={StaticResource Visible}}"
                                        ToolTip="Check that each checked Helix item's folder has every file Helix has for it; missing files can then be downloaded" />
                                <Button Content="{Binding MoveBackText}" Click="MoveBack_Click" Margin="0,2,6,2"
                                        Visibility="{Binding CanMoveBack, Converter={StaticResource Visible}}"
                                        ToolTip="Moves checked folders that are in Returned back to the active folder. A preview shows every move first." />
                                <Button Content="{Binding MarkReturnedText}" Click="MarkReturned_Click" Margin="0,2,6,2"
                                        Visibility="{Binding CanMarkReturned, Converter={StaticResource Visible}}"
                                        ToolTip="{Binding MarkReturnedToolTip}" />
                            </WrapPanel>
                            <Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="{Binding DownloadCheckedText}" Click="DownloadChecked_Click"
                                    Visibility="{Binding CanDownloadChecked, Converter={StaticResource Visible}}"
                                    ToolTip="Download the checked Helix items: one window lists them all with their files and where they go"
                                    VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Footer: only while there is something to say. -->
        <Border Grid.Row="2" Padding="20,6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource SurfaceBackground}" Visibility="{Binding HasFooter, Converter={StaticResource Visible}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Working…" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusMessage}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
