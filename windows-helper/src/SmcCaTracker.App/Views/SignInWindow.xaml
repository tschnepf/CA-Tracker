<Window x:Class="SmcCaTracker.App.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Connect — CA Tracker"
        Width="1100" Height="780" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,10" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button x:Name="DoneButton" DockPanel.Dock="Right" Content="Close" Click="Done_Click" Margin="8,0,0,0" />
                <Button x:Name="HomeButton" DockPanel.Dock="Right" Content="Start page" Click="Home_Click" Margin="8,0,0,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="Browser" Grid.Row="1" />
    </Grid>
</Window>
