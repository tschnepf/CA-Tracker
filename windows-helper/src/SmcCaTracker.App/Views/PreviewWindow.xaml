<Window x:Class="SmcCaTracker.App.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review changes"
        Width="860" Height="600" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="OperationsList" Margin="0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding FromText}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasFrom, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding ToText}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource WarningBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding HasWarning, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding Blocked}" Foreground="{DynamicResource DangerBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding HasBlocked, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="SemiBold"
                                                   Visibility="{Binding HasOutcome, Converter={StaticResource Visible}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OutcomeKind}" Value="Failed">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding OutcomeKind}" Value="Skipped">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="FooterText" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Muted}" />
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="Apply_Click" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" IsCancel="True" IsDefault="True"
                    Margin="0,0,8,0" Click="Cancel_Click" />
        </DockPanel>
    </Grid>
</Window>
