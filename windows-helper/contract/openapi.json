      "CaObservationPartRequest": {
        "type": "object",
        "description": "One part of one scan of one provider project (decision D7).\n\nEvery part repeats the envelope. Parts are stored as they arrive; completeness,\nremovals and counts are applied when the last part has arrived.",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\d+\\.\\d+$",
            "maxLength": 16
          },
          "appVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "clientId": {
            "type": "string",
            "format": "uuid"
          },
          "observationId": {
            "type": "string",
            "format": "uuid"
          },
          "part": {
            "type": "integer",
            "maximum": 200,
            "minimum": 1
          },
          "totalParts": {
            "type": "integer",
            "maximum": 200,
            "minimum": 1
          },
          "observationKind": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CaObservationKindEnum"
              }
            ],
            "description": "items for bound or tracked projects; catalog (counts only) for every other project.\n\n* `items` - Items\n* `catalog` - Catalog"
          },
          "providerProject": {
            "$ref": "#/components/schemas/CaProviderProjectRequest"
          },
          "bindings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CaBindingAssertionRequest"
            },
            "maxItems": 3
          },
          "scannedAt": {
            "type": "string",
            "format": "date-time"
          },
          "coverage": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CaCoverageRequest"
            },
            "maxItems": 2,
            "minItems": 1
          },
          "collector": {
            "$ref": "#/components/schemas/CaCollectorRequest"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CaItemRequest"
            },
            "maxItems": 500
          },
          "removed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CaRemovedItemRequest"
            },
            "description": "Items gone since the last scan; applied on the last part when presence is verified.",
            "maxItems": 5000
          }
        },
        "required": [
          "appVersion",
          "bindings",
          "clientId",
          "collector",
          "coverage",
          "items",
          "observationId",
          "observationKind",
          "part",
          "providerProject",
          "removed",
          "scannedAt",
          "schemaVersion",
          "totalParts"
        ]
      },
